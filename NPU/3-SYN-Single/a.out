        active = 1'h0;
        compute = 1'h0;
        addr1 = 5'h0;
        signed1 = 1'h0;
        divide1 = 1'h0;
        addr2 = 5'h0;
        signed2d = 1'h0;
        signed2r = 1'h0;
        divide2 = 1'h0;
        count = 6'h0;
        divide = 32'h0;
        remain = 32'h0;
