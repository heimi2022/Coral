  ) uop_information
  (
    .clk    (clk),
    .rst_n  (rst_n),
    .e      (fdiv_uop_valid&fdiv_uop_ready),
    .d      (uop_info),
    .q      (uop_info_d1)
  );

  // fp rounding mode
  always_comb begin
    case(fdiv_uop.frm)
      FRNE:    frm = fpnew_pkg::RNE;
      FRTZ:    frm = fpnew_pkg::RTZ;
      FRDN:    frm = fpnew_pkg::RDN;
      FRUP:    frm = fpnew_pkg::RUP;
      FRMM:    frm = fpnew_pkg::RMM;
      default: frm = fpnew_pkg::DYN;
