module rvv_backend_retire_waw(
  valid,
  w_index,
  w_strobe,
  w_data,
  waw,
  res,
  res_strobe
);
  parameter UOP_NUM = 2;
//
// interface signals
//
  input   logic [UOP_NUM-1:0]                           valid;
  input   logic [UOP_NUM-1:0][5-1:0] w_index;
  input   logic [UOP_NUM-1:0][(128/8)-1:0]               w_strobe;
  input   logic [UOP_NUM-1:0][128-1:0]                w_data;
  output  logic [4-1:0]                       waw;
  output  logic [128-1:0]                             res;
  output  logic [(128/8)-1:0]                            res_strobe;
//
// internal signals
//
  logic   [UOP_NUM-1:0] vd_hit;
    
  always_comb begin
    res         = 'b0;
    res_strobe  = 'b0;
    vd_hit      = 'b0;

    for(int i=0;i<UOP_NUM;i++) begin
      vd_hit[i] = valid[i]&valid[UOP_NUM-1]&(w_index[i]==w_index[UOP_NUM-1]);
      
      for(int j=0;j<(128/8);j++) begin
        if(vd_hit[i]&w_strobe[i][j]) begin
          res_strobe[j]                   = 'b1;
          res[j*8+:8] = w_data[i][j*8+:8];
        end
      end
    end
  end
  
  assign waw = (4)'(vd_hit[UOP_NUM-2:0]); 
endmodule
