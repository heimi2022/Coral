              end
              EEW32: begin
                for(int i=0;i<(128/32);i=i+1) begin
                  src2_data32[i]    = vs2_data[i*32 +: 32];
                  shift_amount32[i] = rs1_data[0 +: $clog2(32)];
                end
              end
            endcase 
          end
        endcase
      end
    endcase
  end

  // get mode for f_addsub
  always_comb begin
    // initial the data
    shift_mode = SHIFT_SLL;

    // prepare source data
    case(uop_funct3) 
      OPIVV,
      OPIVX,
      OPIVI: begin
        case(uop_funct6.ari_funct6)    
          VSLL: begin
            shift_mode = SHIFT_SLL;
          end
          VSRL,
          VNSRL,
          VSSRL,
          VNCLIPU: begin
            shift_mode = SHIFT_SRL;
          end
          VSRA,
          VNSRA,
          VSSRA,
          VNCLIP: begin
            shift_mode = SHIFT_SRA;
          end
        endcase
      end
    endcase
  end

//    
// calculate the result
//
  // shift instructions
  generate
    for (j=0;j<(128/8)/2;j=j+1) begin: EXE_PROD8
      barrel_shifter #(
        .DATA_WIDTH   (8*2)
      ) shifter8 (
        .din          ({src2_data8[j],8'b0}),            
        .shift_amount ({1'b0,shift_amount8[j]}),
        .shift_mode   (shift_mode),     
        .dout         ({product8_tmp[j], round_bits8_tmp[j]}) 
      );
    end
  
    for (j=0;j<(128/16)/2;j=j+1) begin: EXE_PROD16
      barrel_shifter #(
        .DATA_WIDTH   (16*2)
      ) shifter16 (
        .din          ({src2_data16[j],16'b0}),            
        .shift_amount ({1'b0,shift_amount16[j]}),
        .shift_mode   (shift_mode),     
        .dout         ({product16_tmp[j], round_bits16_tmp[j]}) 
      );
    end

    for (j=0;j<(128/32);j=j+1) begin: EXE_PROD32
      barrel_shifter #(
        .DATA_WIDTH   (32*2)
      ) shifter32 (
        .din          ({src2_data32[j],32'b0}),            
        .shift_amount ({1'b0,shift_amount32[j]}),
        .shift_mode   (shift_mode),     
        .dout         ({product32_tmp[j], round_bits32_tmp[j]}) 
      );
    end
  endgenerate 
  
  always_comb begin
    product8    = 'b0;
    round_bits8 = 'b0;

    for(int i=0;i<(128/8)/2;i=i+1) begin
      product8[i]    = product8_tmp[i];
      round_bits8[i] = round_bits8_tmp[i];
    end
    for(int i=(128/8)/2;i<(128/8)*3/4;i=i+1) begin
      product8[i]    = product16_tmp[   i-(128/8)/2][0           +: 8];
      round_bits8[i] = round_bits16_tmp[i-(128/8)/2][8 +: 8];
    end         
    for(int i=(128/8)*3/4;i<(128/8);i=i+1) begin
      product8[i]    = product32_tmp[   i-(128/8)*3/4][0             +: 8];
      round_bits8[i] = round_bits32_tmp[i-(128/8)*3/4][3*8 +: 8];
    end
  end
 
  always_comb begin
    product16    = 'b0;
    round_bits16 = 'b0;

    for(int i=0;i<(128/16)/2;i=i+1) begin
      product16[i]    = product16_tmp[i];
      round_bits16[i] = round_bits16_tmp[i];
    end
    for(int i=(128/16)/2;i<(128/16);i=i+1) begin
      product16[i]    = product32_tmp[   i-(128/16)/2][0            +: 16];
      round_bits16[i] = round_bits32_tmp[i-(128/16)/2][16 +: 16];
    end   
  end

  always_comb begin
    product32    = 'b0;
    round_bits32 = 'b0;

    for(int i=0;i<(128/32);i=i+1) begin
      product32[i]    = product32_tmp[i];
      round_bits32[i] = round_bits32_tmp[i];
    end
  end

  // round increment
  generate
    for (j=0;j<(128/8);j++) begin: INCREMENT8
      always_comb begin
        round_increment8[j] = 'b0;
        
        case(vxrm)
          RNU: begin
            round_increment8[j] = round_bits8[j][8-1];
          end
          RNE: begin
            round_increment8[j] = round_bits8[j][8-1] & ((round_bits8[j][8-2:0]!='b0) | product8[j][0]);
          end
          RDN: begin
            round_increment8[j] = 'b0;
          end
          ROD: begin
            round_increment8[j] = (!product8[j][0]) & (round_bits8[j]!='b0);
          end
        endcase
      end
    end
  endgenerate

  generate
    for (j=0;j<(128/16);j++) begin: INCREMENT16
      always_comb begin
        round_increment16[j] = 'b0;
        
        case(vxrm)
          RNU: begin
            round_increment16[j] = round_bits16[j][16-1];
          end
          RNE: begin
            round_increment16[j] = round_bits16[j][16-1] & ((round_bits16[j][16-2:0]!='b0) | product16[j][0]);
          end
          RDN: begin
            round_increment16[j] = 'b0;
          end
          ROD: begin
            round_increment16[j] = (!product16[j][0]) & (round_bits16[j]!='b0);
          end
        endcase
      end
    end
  endgenerate

  generate
    for (j=0;j<(128/32);j++) begin: INCREMENT32
      always_comb begin
        round_increment32[j] = 'b0;
        
        case(vxrm)
          RNU: begin
            round_increment32[j] = round_bits32[j][32-1];
          end
          RNE: begin
            round_increment32[j] = round_bits32[j][32-1] & ((round_bits32[j][32-2:0]!='b0) | product32[j][0]);
          end
          RDN: begin
            round_increment32[j] = 'b0;
          end
          ROD: begin
            round_increment32[j] = (!product32[j][0]) & (round_bits32[j]!='b0);
          end
        endcase
      end
    end
  endgenerate

  // rounding result
  always_comb begin
    for(int i=0;i<(128/8);i++) begin: ROUND8
      if (shift_mode == SHIFT_SLL)
        round8[i] = 'b0;
      else
        round8[i] = round_increment8[i] ? product8[i]+'b1 : product8[i]; 
    end
  end

  always_comb begin
    for(int i=0;i<(128/16);i++) begin: ROUND16
      if (shift_mode == SHIFT_SRL)
        {cout16[i], round16[i]} = round_increment16[i] ? {1'b0, product16[i]}+'b1 : {1'b0, product16[i]}; 
      else if (shift_mode == SHIFT_SRA)
        {cout16[i], round16[i]} = round_increment16[i] ? {product16[i][16-1], product16[i]}+'b1 : {product16[i][16-1], product16[i]}; 
      else begin
        cout16[i]  = 'b0; 
        round16[i] = 'b0;
      end
    end
  end

  always_comb begin
    for(int i=0;i<(128/32);i++) begin: ROUND32
      if (shift_mode == SHIFT_SRL)
        {cout32[i], round32[i]} = round_increment32[i] ? {1'b0, product32[i]}+'b1 : {1'b0, product32[i]}; 
      else if (shift_mode == SHIFT_SRA)
        {cout32[i], round32[i]} = round_increment32[i] ? {product32[i][32-1], product32[i]}+'b1 : {product32[i][32-1], product32[i]}; 
      else begin
        cout32[i]  = 'b0; 
        round32[i] = 'b0;
      end
    end
  end

  // overflow check for vnclipu and vnclip 
  generate 
    for (j=0;j<(128/32)/2;j++) begin: GET_OVERFLOW
      always_comb begin
        // initial
        upoverflow[   4*j +: 4] = 'b0;
        underoverflow[4*j +: 4] = 'b0;
        upoverflow[   4*(j+(128/32)/2) +: 4] = 'b0;
        underoverflow[4*(j+(128/32)/2) +: 4] = 'b0;
          
        case(vs2_eew)
          EEW16: begin
            case(shift_mode)
              SHIFT_SRL: begin
              // unsigned overflow check for vnclipu
                if(uop_index[0]==1'b0) begin
                  upoverflow[4*j +: 4] = {
                    ({cout16[4*j+3], round16[4*j+3][8 +: 8]}!='b0),
                    ({cout16[4*j+2], round16[4*j+2][8 +: 8]}!='b0),
                    ({cout16[4*j+1], round16[4*j+1][8 +: 8]}!='b0),
                    ({cout16[4*j  ], round16[4*j  ][8 +: 8]}!='b0)};

                  upoverflow[4*(j+(128/32)/2) +: 4] = 'b0;
                end
                else begin
                  upoverflow[4*j +: 4] = 'b0;

                  upoverflow[4*(j+(128/32)/2) +: 4] = {
                    ({cout16[4*j+3], round16[4*j+3][8 +: 8]}!='b0),
                    ({cout16[4*j+2], round16[4*j+2][8 +: 8]}!='b0),
                    ({cout16[4*j+1], round16[4*j+1][8 +: 8]}!='b0),
                    ({cout16[4*j  ], round16[4*j  ][8 +: 8]}!='b0)};
                end
              end
              SHIFT_SRA: begin
              // signed overflow check for vnclip
                if(uop_index[0]==1'b0) begin
                  upoverflow[4*j +: 4] = {
                    (cout16[4*j+3]=='b0)&(round16[4*j+3][8-1 +: 8+1]!='b0),
                    (cout16[4*j+2]=='b0)&(round16[4*j+2][8-1 +: 8+1]!='b0),
                    (cout16[4*j+1]=='b0)&(round16[4*j+1][8-1 +: 8+1]!='b0),
                    (cout16[4*j  ]=='b0)&(round16[4*j  ][8-1 +: 8+1]!='b0)};

                  underoverflow[4*j +: 4] = {
                    (cout16[4*j+3]=='b1)&(round16[4*j+3][8-1 +: 8+1]!='h1ff),
                    (cout16[4*j+2]=='b1)&(round16[4*j+2][8-1 +: 8+1]!='h1ff),
                    (cout16[4*j+1]=='b1)&(round16[4*j+1][8-1 +: 8+1]!='h1ff),
                    (cout16[4*j  ]=='b1)&(round16[4*j  ][8-1 +: 8+1]!='h1ff)};

                  upoverflow[4*(j+(128/32)/2) +: 4] = 'b0;
                  underoverflow[4*(j+(128/32)/2) +: 4] = 'b0;
                end
                else begin
                  upoverflow[4*j +: 4] = 'b0;
                  underoverflow[4*j +: 4] = 'b0;

                  upoverflow[4*(j+128/32/2) +: 4] = {
                    (cout16[4*j+3]=='b0)&(round16[4*j+3][8-1 +: 8+1]!='b0),
                    (cout16[4*j+2]=='b0)&(round16[4*j+2][8-1 +: 8+1]!='b0),
                    (cout16[4*j+1]=='b0)&(round16[4*j+1][8-1 +: 8+1]!='b0),
                    (cout16[4*j  ]=='b0)&(round16[4*j  ][8-1 +: 8+1]!='b0)};

                  underoverflow[4*(j+128/32/2) +: 4] = {
                    (cout16[4*j+3]=='b1)&(round16[4*j+3][8-1 +: 8+1]!='h1ff),
                    (cout16[4*j+2]=='b1)&(round16[4*j+2][8-1 +: 8+1]!='h1ff),
                    (cout16[4*j+1]=='b1)&(round16[4*j+1][8-1 +: 8+1]!='h1ff),
                    (cout16[4*j  ]=='b1)&(round16[4*j  ][8-1 +: 8+1]!='h1ff)};
                end
              end
            endcase
          end
          EEW32: begin
            case(shift_mode)
              SHIFT_SRL: begin
              // unsigned overflow check for vnclipu
                if(uop_index[0]==1'b0) begin
                  upoverflow[4*j +: 4] = {
                    ({cout32[2*j+1], round32[2*j+1][16 +: 16]}!='b0),1'b0,
                    ({cout32[2*j  ], round32[2*j  ][16 +: 16]}!='b0),1'b0};

                  upoverflow[4*(j+(128/32)/2) +: 4] = 'b0;
                end
                else begin
                  upoverflow[4*j +: 4] = 'b0;

                  upoverflow[4*(j+(128/32)/2) +: 4] = {
                    ({cout32[2*j+1], round32[2*j+1][16 +: 16]}!='b0),1'b0,
                    ({cout32[2*j  ], round32[2*j  ][16 +: 16]}!='b0),1'b0};
                end
              end
              SHIFT_SRA: begin
              // unsigned overflow check for vnclip
                if(uop_index[0]==1'b0) begin
                  upoverflow[4*j +: 4] = {
                    (cout32[2*j+1]=='b0)&(round32[2*j+1][16-1 +: 16+1]!='b0),1'b0,
                    (cout32[2*j  ]=='b0)&(round32[2*j  ][16-1 +: 16+1]!='b0),1'b0};

                  underoverflow[4*j +: 4] = {
                    (cout32[2*j+1]=='b1)&(round32[2*j+1][16-1 +: 16+1]!='h1ffff),1'b0,
                    (cout32[2*j  ]=='b1)&(round32[2*j  ][16-1 +: 16+1]!='h1ffff),1'b0};

                  upoverflow[4*(j+(128/32)/2) +: 4] = 'b0;
                  underoverflow[4*(j+(128/32)/2) +: 4] = 'b0;
                end
                else begin
                  upoverflow[4*j +: 4] = 'b0;
                  underoverflow[4*j +: 4] = 'b0;

                  upoverflow[4*(j+128/32/2) +: 4] = {
                    (cout32[2*j+1]=='b0)&(round32[2*j+1][16-1 +: 16+1]!='b0),1'b0,
                    (cout32[2*j  ]=='b0)&(round32[2*j  ][16-1 +: 16+1]!='b0),1'b0};

                  underoverflow[4*(j+128/32/2) +: 4] = {
                    (cout32[2*j+1]=='b1)&(round32[2*j+1][16-1 +: 16+1]!='h1ffff),1'b0,
                    (cout32[2*j  ]=='b1)&(round32[2*j  ][16-1 +: 16+1]!='h1ffff),1'b0};
                end
              end
            endcase
          end
        endcase
      end
    end
  endgenerate

  // assign to result_data
  always_comb begin
    // initial the data
    result_data = 'b0;
 
    for(int i=0;i<(128/32);i++) begin
      // calculate result data
      case(uop_funct3) 
        OPIVV,
        OPIVX,
        OPIVI: begin
          case(uop_funct6.ari_funct6)
            VSLL,
            VSRL,
            VSRA: begin
              case(vs2_eew)
                EEW8: begin
                  result_data[i*32 +: 32] = {product8[4*i+3],product8[4*i+2],product8[4*i+1],product8[4*i]};
                end
                EEW16: begin
                  result_data[i*32 +: 32] = {product16[2*i+1],product16[2*i]};
                end
                EEW32: begin
                  result_data[i*32 +: 32] = product32[i];
                end
              endcase
            end
  
            VNSRL,
            VNSRA: begin
              case(vs2_eew)
                EEW16: begin
                  if (uop_index[0]==1'b0)
                    result_data[i*16         +: 16] = {product16[2*i+1][8-1:0],product16[2*i][8-1:0]};
                  else
                    result_data[128/2+i*16 +: 16] = {product16[2*i+1][8-1:0],product16[2*i][8-1:0]};
                end
                EEW32: begin
                  if (uop_index[0]==1'b0)
                    result_data[i*16         +: 16] = product32[i][16-1:0];
                  else
                    result_data[128/2+i*16 +: 16] = product32[i][16-1:0];
                end
              endcase
            end

            VSSRL,
            VSSRA: begin
              case(vs2_eew)
                EEW8: begin
                  result_data[i*32 +: 32] = {round8[4*i+3],round8[4*i+2],round8[4*i+1],round8[4*i]};
                end
                EEW16: begin
                  result_data[i*32 +: 32] = {round16[2*i+1],round16[2*i]};
                end
                EEW32: begin
                  result_data[i*32 +: 32] = round32[i];
                end
              endcase
            end

            VNCLIPU: begin
              case(vs2_eew)
                EEW16: begin
                  if (i<(128/32)/2) begin
                    if (upoverflow[4*i])
                      result_data[(4*i)*8 +: 8] = 'hff;
                    else
                      result_data[(4*i)*8 +: 8] = round16[4*i][8-1 : 0];

                    if (upoverflow[4*i+1])
                      result_data[(4*i+1)*8 +: 8] = 'hff;
                    else
                      result_data[(4*i+1)*8 +: 8] = round16[4*i+1][8-1 : 0];

                    if (upoverflow[4*i+2])
                      result_data[(4*i+2)*8 +: 8] = 'hff;
                    else
                      result_data[(4*i+2)*8 +: 8] = round16[4*i+2][8-1 : 0];

                    if (upoverflow[4*i+3])
                      result_data[(4*i+3)*8 +: 8] = 'hff;
                    else
                      result_data[(4*i+3)*8 +: 8] = round16[4*i+3][8-1 : 0];
                  end
                  else begin
                    if (upoverflow[4*i])
                      result_data[(4*i)*8 +: 8] = 'hff;
                    else
                      result_data[(4*i)*8 +: 8] = round16[4*(i-(128/32)/2)][8-1 : 0];

                    if (upoverflow[4*i+1])
                      result_data[(4*i+1)*8 +: 8] = 'hff;
                    else
                      result_data[(4*i+1)*8 +: 8] = round16[4*(i-(128/32)/2)+1][8-1 : 0];

                    if (upoverflow[4*i+2])
                      result_data[(4*i+2)*8 +: 8] = 'hff;
                    else
                      result_data[(4*i+2)*8 +: 8] = round16[4*(i-(128/32)/2)+2][8-1 : 0];

                    if (upoverflow[4*i+3])
                      result_data[(4*i+3)*8 +: 8] = 'hff;
                    else
                      result_data[(4*i+3)*8 +: 8] = round16[4*(i-(128/32)/2)+3][8-1 : 0];
                  end
                end
                EEW32: begin
                  if (i<(128/32)/2) begin
                    if (upoverflow[4*i+1])
                      result_data[(2*i)*16 +: 16] = 'hffff;
                    else
                      result_data[(2*i)*16 +: 16] = round32[2*i][16-1 : 0];

                    if (upoverflow[4*i+3])
                      result_data[(2*i+1)*16 +: 16] = 'hffff;
                    else
                      result_data[(2*i+1)*16 +: 16] = round32[2*i+1][16-1 : 0];
                  end
                  else begin
                    if (upoverflow[4*i+1])
                      result_data[(2*i)*16 +: 16] = 'hffff;
                    else
                      result_data[(2*i)*16 +: 16] = round32[2*(i-(128/32)/2)][16-1 : 0];

                    if (upoverflow[4*i+3])
                      result_data[(2*i+1)*16 +: 16] = 'hffff;
                    else
                      result_data[(2*i+1)*16 +: 16] = round32[2*(i-(128/32)/2)+1][16-1 : 0];
                  end
                end
              endcase
            end

            VNCLIP: begin
              case(vs2_eew)
                EEW16: begin
                  if (i<(128/32)/2) begin
                    if (upoverflow[4*i])
                      result_data[(4*i)*8 +: 8] = 'h7f;
                    else if (underoverflow[4*i])
                      result_data[(4*i)*8 +: 8] = 'h80;
                    else
                      result_data[(4*i)*8 +: 8] = round16[4*i][8-1 : 0];

                    if (upoverflow[4*i+1])
                      result_data[(4*i+1)*8 +: 8] = 'h7f;
                    else if (underoverflow[4*i+1])
                      result_data[(4*i+1)*8 +: 8] = 'h80;
                    else
                      result_data[(4*i+1)*8 +: 8] = round16[4*i+1][8-1 : 0];

                    if (upoverflow[4*i+2])
                      result_data[(4*i+2)*8 +: 8] = 'h7f;
                    else if (underoverflow[4*i+2])
                      result_data[(4*i+2)*8 +: 8] = 'h80;
                    else
                      result_data[(4*i+2)*8 +: 8] = round16[4*i+2][8-1 : 0];

                    if (upoverflow[4*i+3])
                      result_data[(4*i+3)*8 +: 8] = 'h7f;
                    else if (underoverflow[4*i+3])
                      result_data[(4*i+3)*8 +: 8] = 'h80;
                    else
                      result_data[(4*i+3)*8 +: 8] = round16[4*i+3][8-1 : 0];
                  end
                  else begin
                    if (upoverflow[4*i])
                      result_data[(4*i)*8 +: 8] = 'h7f;
                    else if (underoverflow[4*i])
                      result_data[(4*i)*8 +: 8] = 'h80;
                    else
                      result_data[(4*i)*8 +: 8] = round16[4*(i-(128/32)/2)][8-1 : 0];

                    if (upoverflow[4*i+1])
                      result_data[(4*i+1)*8 +: 8] = 'h7f;
                    else if (underoverflow[4*i+1])
                      result_data[(4*i+1)*8 +: 8] = 'h80;
                    else
                      result_data[(4*i+1)*8 +: 8] = round16[4*(i-(128/32)/2)+1][8-1 : 0];

                    if (upoverflow[4*i+2])
                      result_data[(4*i+2)*8 +: 8] = 'h7f;
                    else if (underoverflow[4*i+2])
                      result_data[(4*i+2)*8 +: 8] = 'h80;
                    else
                      result_data[(4*i+2)*8 +: 8] = round16[4*(i-(128/32)/2)+2][8-1 : 0];

                    if (upoverflow[4*i+3])
                      result_data[(4*i+3)*8 +: 8] = 'h7f;
                    else if (underoverflow[4*i+3])
                      result_data[(4*i+3)*8 +: 8] = 'h80;
                    else
                      result_data[(4*i+3)*8 +: 8] = round16[4*(i-(128/32)/2)+3][8-1 : 0];
                  end
                end
                EEW32: begin
                  if (i<(128/32)/2) begin
                    if (upoverflow[4*i+1])
                      result_data[(2*i)*16 +: 16] = 'h7fff;
                    else if (underoverflow[4*i+1])
                      result_data[(2*i)*16 +: 16] = 'h8000;
                    else
                      result_data[(2*i)*16 +: 16] = round32[2*i][16-1 : 0];

                    if (upoverflow[4*i+3])
                      result_data[(2*i+1)*16 +: 16] = 'h7fff;
                    else if (underoverflow[4*i+3])
                      result_data[(2*i+1)*16 +: 16] = 'h8000;
                    else
                      result_data[(2*i+1)*16 +: 16] = round32[2*i+1][16-1 : 0];
                  end
                  else begin
                    if (upoverflow[4*i+1])
                      result_data[(2*i)*16 +: 16] = 'h7fff;
                    else if (underoverflow[4*i+1])
                      result_data[(2*i)*16 +: 16] = 'h8000;
                    else
                      result_data[(2*i)*16 +: 16] = round32[2*(i-(128/32)/2)][16-1 : 0];

                    if (upoverflow[4*i+3])
                      result_data[(2*i+1)*16 +: 16] = 'h7fff;
                    else if (underoverflow[4*i+3])
                      result_data[(2*i+1)*16 +: 16] = 'h8000;
                    else
                      result_data[(2*i+1)*16 +: 16] = round32[2*(i-(128/32)/2)+1][16-1 : 0];
                  end
                end
              endcase
            end
          endcase
        end
      endcase
    end
  end

//
// submit result to ROB
//
  // saturate signal
  always_comb begin
    // initial
  


    result.rob_entry = rob_entry;
    result.w_data    = result_data;
    result.w_valid   = result_valid;
    result.vsaturate = 'b0;
  



    case(uop_funct3) 
      OPIVV,
      OPIVX,
      OPIVI: begin
        case(uop_funct6.ari_funct6)
          VNCLIPU: begin
            result.vsaturate = upoverflow;
          end
          VNCLIP: begin
            result.vsaturate = underoverflow|upoverflow;
          end
        endcase
      end
    endcase
  end

endmodule
