  logic [ALU_BYTE-1:0][7:0] vs1_t4;        // source value for reduction vs1[0]
  logic [(128/8)-1:0]        vs2_m_t4;
  logic [M_SUM_NUM-1:0][$clog2(128)-1:0]  vs2_m_sum_t3_tmp, vs2_m_sum_t4;
  // ALU_STAGE_NUM > 3
  RDT_ALU_t                 alu_ctrl_t5;
  logic                     alu_t5_valid;
  logic                     alu_t5_ready;
  logic [ALU_NUM_T4-1:0][ALU_BYTE-1:0][7:0] src1_t4, src2_t4, dst_t4, data_t5; // reduction operation in 1 stage: source value for reduction data_t4
  logic [ALU_BYTE-1:0][7:0] vs1_t5;        // source value for reduction vs1[0]
  logic [(128/8)-1:0]        vs2_m_t5;
  logic [M_SUM_NUM-1:0][$clog2(128)-1:0]  vs2_m_sum_t4_tmp, vs2_m_sum_t5;

  // ALU_STAGE_NUM == 0
  logic [128/ALU_WIDTH-1:0][ALU_BYTE-1:0][7:0]   viota_src2_t0;
  logic [128/ALU_WIDTH-1:0][ALU_BYTE-1:0][7:0]   viota_src2_t1;
  logic [ALU_BYTE-1:0][7:0] vs1_rdt_vm_t0;
  logic [ALU_BYTE-1:0][7:0] vs1_rdt_vm_t1;
  // ALU_STAGE_NUM == 1
  logic [128/ALU_WIDTH-1:0][ALU_BYTE-1:0][7:0]   viota_src2_t2;
  logic [ALU_BYTE-1:0][7:0] vs1_rdt_vm_t2;
  // ALU_STAGE_NUM == 2
  logic [128/ALU_WIDTH-1:0][ALU_BYTE-1:0][7:0]   viota_src2_t3;
  logic [ALU_BYTE-1:0][7:0] vs1_rdt_vm_t3;
  // ALU_STAGE_NUM == 3
  logic [128/ALU_WIDTH-1:0][ALU_BYTE-1:0][7:0]   viota_src2_t4;
  logic [ALU_BYTE-1:0][7:0] vs1_rdt_vm_t4;
  // ALU_STAGE_NUM == 4
  logic [128/ALU_WIDTH-1:0][ALU_BYTE-1:0][7:0]   viota_src2_t5;
  logic [ALU_BYTE-1:0][7:0] vs1_rdt_vm_t5;

  RDT_ALU_t                 alu_ctrl;
  logic                     alu_ctrl_valid;
  logic [ALU_BYTE-1:0][7:0] rdt_vs2, rdt_vs1;
  logic [7:0]               rdt_src1_8b,  rdt_src2_8b;
  logic [7:0]               rdt_vs1_8b,  rdt_vs2_8b,  dst_8b;
  logic [15:0]              rdt_vs1_16b, rdt_vs2_16b, dst_16b;
  logic [31:0]              rdt_vs1_32b, rdt_vs2_32b, dst_32b;
  logic [ALU_WIDTH-1:0]     rdt_dst;
  logic [ALU_BYTE-1:0][7:0] rdt_pre_dst;

  logic [ALU_BYTE-1:0][7:0] viota_src1;
  logic [128/ALU_WIDTH-1:0][ALU_BYTE-1:0][7:0]   viota_src2;
  logic [128/ALU_WIDTH-1:0][ALU_BYTE-1:0]        viota_cin;
  logic [128/ALU_WIDTH-1:0][ALU_BYTE-1:0]        viota_cout;
  logic [128/ALU_WIDTH-1:0][ALU_BYTE-1:0][7:0]   viota_dst;

  genvar i;

// ---code start------------------------------------------------------
  // VM FSM
  always_comb begin
    next_vm_state = MSK0;
    state_en = 1'b0;
    vm_en = 1'b0;
    vm_last_opr = 1'b0;
    case (vm_state)
      MSK0: begin
        if(rdt_uop_valid & ((vm_ctrl.uop_funct6==VWRXUNARY0)|(vm_ctrl.uop_funct6==VMUNARY0))) begin
          if (vm_cnt < vm_ctrl.vlmax) begin
            next_vm_state = MSKN;
            state_en = 1'b1;
            vm_en = 1'b1;
          end else begin
            vm_last_opr = 1'b1;
          end
        end
      end
      default: begin // MSKN
        if (vm_cnt >= vm_ctrl_q.vlmax) begin
          next_vm_state = MSK0;
          state_en = vm_ctrl_q.uop_funct6==VMUNARY0 ? rdt_uop_valid : 1'b1;
          vm_last_opr = 1'b1;
        end
        vm_en = 1'b1;
      end
    endcase
  end
  cdffr #(.T(VM_STATE_e), .INIT(MSK0)) vm_state_reg (.q(vm_state), .d(next_vm_state), .c(trap_flush_rvv), .e(state_en&alu_t0_valid&alu_t0_ready), .clk(clk), .rst_n(rst_n));
  
  // vm_cnt
  always_comb begin
    case (vm_state)
      MSK0: begin
        case (vm_ctrl.uop_funct6)
          VMUNARY0: begin
            case (vm_ctrl.vd_eew)
              EEW32: vm_cnt = (128/32);
              EEW16: vm_cnt = (128/16);
              default: vm_cnt = (128/8);
            endcase
          end
          default: vm_cnt = (128/16);
        endcase
      end
      default: begin // MSKN
        case (vm_ctrl_q.uop_funct6)
          VMUNARY0: begin
            case (vm_ctrl_q.vd_eew)
              EEW32: vm_cnt = vm_cnt_q + (128/32);
              EEW16: vm_cnt = vm_cnt_q + (128/16);
              default: vm_cnt = vm_cnt_q + (128/8);
            endcase
          end
          default: vm_cnt = vm_cnt_q +(128/16);
        endcase
      end
    endcase
  end
  cdffr #(.T(logic[$clog2(128)+1-1:0])) vm_cnt_reg (.q(vm_cnt_q), .d(vm_cnt), .c(trap_flush_rvv), .e(vm_en&alu_t0_valid&alu_t0_ready), .clk(clk), .rst_n(rst_n));

  // vs2_m data
  barrel_shifter #(.DATA_WIDTH(128)) 
  u_tail (.din((128)'('1)), .shift_amount(rdt_uop.vl[$clog2(128)-1:0]), .shift_mode(2'b00), .dout(vs2_m_tail_tmp));
  
  assign vs2_m_tail = rdt_uop.vl[$clog2(128)] ? 'b0 : vs2_m_tail_tmp;
  assign vs2_m_body = ~vs2_m_tail;
  assign vs2_m = rdt_uop.vs2_data & (rdt_uop.v0_data | {(128){rdt_uop.vm}}) & vs2_m_body;

  always_comb begin
    case (vm_state)
      MSK0: begin
        case (vm_ctrl.uop_funct6)
          VMUNARY0: begin
            case (vm_ctrl.vd_eew)
              EEW32: vs2_m_d = vs2_m >> (128/32);
              EEW16: vs2_m_d = vs2_m >> (128/16);
              default: vs2_m_d = vs2_m >> (128/8); //EEW8
            endcase
          end
          default: vs2_m_d = vs2_m >> (128/16); // vcpop updates a XRF.
                                              // in general, `VL_WIDTH is very less than `XLEN.
        endcase
      end
      default: begin //MSKN
        case (vm_ctrl_q.uop_funct6)
          VMUNARY0: begin
            case (vm_ctrl_q.vd_eew)
              EEW32: vs2_m_d = vs2_m_q >> (128/32);
              EEW16: vs2_m_d = vs2_m_q >> (128/16);
              default: vs2_m_d = vs2_m_q >> (128/8); //EEW8
            endcase
          end
          default: vs2_m_d = vs2_m_q >> (128/16); // vcpop updates a XRF.
                                              // in general, `VL_WIDTH is very less than `XLEN.
        endcase
      end
    endcase
  end
  edff #(.T(logic[128-1:0])) vs2_m_reg (.q(vs2_m_q), .d(vs2_m_d), .e(vm_en&alu_t0_valid&alu_t0_ready), .clk(clk), .rst_n(rst_n));

  assign vm_ctrl.uop_funct6 = rdt_uop.uop_funct6;
  assign vm_ctrl.vlmax      = rdt_uop.vlmax;
  assign vm_ctrl.vd_eew     = rdt_uop.vd_eew;
  cdffr #(.T(RDT_VM_t)) vm_ctrl_reg (.q(vm_ctrl_q), .d(vm_ctrl), .c(trap_flush_rvv), .e(vm_en&(vm_state==MSK0)&alu_t0_valid&alu_t0_ready), .clk(clk), .rst_n(rst_n));

  // vm_vs2 data
  always_comb begin
    case (vm_state)
      MSK0: begin
        case (vm_ctrl.uop_funct6)
          VMUNARY0: begin
            case (vm_ctrl.vd_eew)
              EEW32: for (int j=0; j<(128/32); j++) vm_vs2[32*j+:32] = {31'h0, vs2_m[j]};
              EEW16: for (int j=0; j<(128/16); j++) vm_vs2[16*j+:16] = {15'h0, vs2_m[j]};
