                  result_data[i*8 +: 8] = quotient32[i-(128/8)*3/4][0 +: 8];
                end
              end
              EEW16: begin
                for (int i=0;i<128/16/2;i++) begin
                  result_data[i*16 +: 16] = quotient16[i];
                end
                for (int i=128/16/2;i<128/16;i++) begin
                  result_data[i*16 +: 16] = quotient32[i-128/16/2][0 +: 16];
                end
              end             
              EEW32: begin
                for (int i=0;i<128/32;i++) begin
                  result_data[i*32 +: 32] = quotient32[i];
                end             
              end
            endcase
          end

          VREMU,
          VREM: begin
            case(res_info_d1.vs2_eew)
              EEW8: begin
                for (int i=0;i<(128/8)/2;i++) begin
                  result_data[i*8 +: 8] = remainder8[i];
                end
                for (int i=(128/8)/2;i<(128/8)*3/4;i++) begin
                  result_data[i*8 +: 8] = remainder16[i-(128/8)/2][0 +: 8];
                end
                for (int i=(128/8)*3/4;i<(128/8);i++) begin
                  result_data[i*8 +: 8] = remainder32[i-(128/8)*3/4][0 +: 8];
                end
              end
              EEW16: begin
                for (int i=0;i<128/16/2;i++) begin
                  result_data[i*16 +: 16] = remainder16[i];
                end
                for (int i=128/16/2;i<128/16;i++) begin
                  result_data[i*16 +: 16] = remainder32[i-128/16/2][0 +: 16];
                end
              end             
              EEW32: begin
                for (int i=0;i<128/32;i++) begin
                  result_data[i*32 +: 32] = remainder32[i];
                end             
              end
            endcase
          end
        endcase
      end
    endcase
  end

//
// submit result to ROB
//



  assign result_valid     = result_all_valid;
  assign result.rob_entry = res_info_d1.rob_entry;
  assign result.w_data    = result_data;
  assign result.w_valid   = result_all_valid;
  assign result.vsaturate = 'b0;




