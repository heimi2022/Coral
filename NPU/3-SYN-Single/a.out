    | (vtypeEn ? io_rvv_vtype : 32'h0);
  wire [1:0]       _GEN = _rdata_T_201[1:0] | (vxrmEn ? io_rvv_vxrm : 2'h0);
  wire [31:0]      rdata =
    {_rdata_T_201[31:2], _GEN[1], _GEN[0] | vxsatEn & io_rvv_vxsat}
    | {27'h0, vlenbEn, 4'h0} | (tdata1En ? tdata1_data : 32'h0)
    | (tdata2En ? tdata2 : 32'h0) | (tinfoEn ? 32'h1000040 : 32'h0)
    | (dcsrEn
