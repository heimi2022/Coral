  assign sub_in_accept     = sub_rdtadd_in_vld && sub_rdtadd_in_rdy && !trap_flush_rvv ||
                             sub_rdtcmp_in_vld && sub_rdtcmp_in_rdy && !trap_flush_rvv ||
                             mask_cur && (!sub_busy || sub_busy && sub_result_vld && sub_result_rdy) && !trap_flush_rvv;




