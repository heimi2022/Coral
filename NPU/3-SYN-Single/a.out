module rvv_backend_alu_unit_mask
(
  alu_uop_valid,
  alu_uop,
  result_valid,
  result
);
//
// interface signals
//
  // ALU RS handshake signals
  input   logic           alu_uop_valid;
  input   ALU_RS_t        alu_uop;

  // ALU send result signals to ROB
  output  logic           result_valid;
  output  PU2ROB_t        result;

//
// internal signals
//
  // ALU_RS_t struct signals
  logic   [$clog2(8)-1:0]      rob_entry;
  FUNCT6_u                            uop_funct6;
  logic   [3-1:0]         uop_funct3;
  logic   [$clog2(128)-1:0]         vstart;
  logic   [128-1:0]                 vstart_elements_tmp;
  logic   [128-1:0]                 vstart_elements;
  logic   [$clog2(128)+1-1:0]             vl;       
  logic                               vm;
  logic   [128-1:0]                 v0_data;           
  logic   [128-1:0]                 vd_data;           
  EEW_e                               vd_eew;
  logic   [5-1:0]  vs1_opcode;              
  logic   [128-1:0]                 vs1_data;           
  logic   [128-1:0]                 vs2_data;	        
  EEW_e                               vs2_eew;
  logic   [32-1:0] 	              rs1_data;        
  logic   [$clog2(8)-1:0]     uop_index;          

  // execute 
  logic   [128-1:0]                 src2_data;
  logic   [128-1:0]                 src2_data_sub1;
  logic   [128-1:0]                 src1_data;
  logic   [128-1:0]                 tail_mask;
  logic   [128-1:0]                 result_data;
  logic   [128-1:0]                 result_data_andn;
  logic   [128-1:0]                 result_data_and; 
  logic   [128-1:0]                 result_data_or;  
  logic   [128-1:0]                 result_data_xor; 
  logic   [128-1:0]                 result_data_orn; 
  logic   [128-1:0]                 result_data_nand;
  logic   [128-1:0]                 result_data_nor; 
  logic   [128-1:0]                 result_data_xnor;
