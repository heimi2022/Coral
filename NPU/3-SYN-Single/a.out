// Generated by CIRCT firtool-1.114.0-2-g6cf2492e1
// description:
// 1. Dispatch unit receives uop instructions from uop queue
// 2. Dispatch unit check rules to determine if the uops are sent to reservation stations(RS). 
//    There are two ways to solve: 
//     a. stall pipeline
//     b. foreward data from ROB
// 3. Dispatch unit read vector data from VRF for uops.








module rvv_backend_dispatch
(
    clk,
    rst_n,
    uop_valid_uop2dp,
    uop_uop2dp,
    uop_ready_dp2uop,
    rs_valid_dp2alu,
    rs_dp2alu,
    rs_ready_alu2dp,
    rs_valid_dp2pmtrdt,
    rs_dp2pmtrdt,
    rs_ready_pmtrdt2dp,
    rs_valid_dp2mul,
    rs_dp2mul,
    rs_ready_mul2dp,
    rs_valid_dp2div,
    rs_dp2div,
    rs_ready_div2dp,





    rs_valid_dp2lsu,
    rs_dp2lsu,
    rs_ready_lsu2dp,
    mapinfo_valid_dp2lsu,
    mapinfo_dp2lsu,
    mapinfo_ready_lsu2dp,
    uop_valid_dp2rob,
    uop_dp2rob,
    uop_ready_rob2dp,
    rob_entry_rob2dp,
    rd_index_dp2vrf,        
    rd_data_vrf2dp,
    v0_mask_vrf2dp,
    rob_entry
);  
// ---port definition-------------------------------------------------
// global signal
    input  logic           clk;
    input  logic           rst_n;

// Uops Queue to Dispatch unit
    input  logic        [3-1:0]         uop_valid_uop2dp;
    input  UOP_QUEUE_t  [3-1:0]         uop_uop2dp;
    output logic        [3-1:0]         uop_ready_dp2uop;

// Dispatch unit sends oprations to reservation stations
// Dispatch unit to ALU reservation station
// rs_*: reservation station
    output logic          [3-1:0]       rs_valid_dp2alu;
    output ALU_RS_t       [3-1:0]       rs_dp2alu;
    input  logic          [3-1:0]       rs_ready_alu2dp;

// Dispatch unit to PMT+RDT reservation station
    output logic          [3-1:0]       rs_valid_dp2pmtrdt;
    output PMT_RDT_RS_t   [3-1:0]       rs_dp2pmtrdt;
    input  logic          [3-1:0]       rs_ready_pmtrdt2dp;

// Dispatch unit to MUL reservation station
    output logic          [3-1:0]       rs_valid_dp2mul;
    output MUL_RS_t       [3-1:0]       rs_dp2mul;
    input  logic          [3-1:0]       rs_ready_mul2dp;

// Dispatch unit to DIV reservation station
    output logic          [3-1:0]       rs_valid_dp2div;
    output DIV_RS_t       [3-1:0]       rs_dp2div;
    input  logic          [3-1:0]       rs_ready_div2dp;








// Dispatch unit to LSU 
    // to LSU RS
    output logic          [3-1:0]       rs_valid_dp2lsu;
    output UOP_RVV2LSU_t  [3-1:0]       rs_dp2lsu;
    input  logic          [3-1:0]       rs_ready_lsu2dp;
    // to LSU MAP INFO
    output logic          [3-1:0]       mapinfo_valid_dp2lsu;
    output LSU_MAP_INFO_t [3-1:0]       mapinfo_dp2lsu;
    input  logic          [3-1:0]       mapinfo_ready_lsu2dp;

// Dispatch unit pushes operations to ROB unit    
    output logic          [3-1:0]       uop_valid_dp2rob;
    output DP2ROB_t       [3-1:0]       uop_dp2rob;
    input  logic          [3-1:0]       uop_ready_rob2dp;
    input  logic          [$clog2(8)-1:0]  rob_entry_rob2dp;

// Dispatch unit sends read request to VRF for vector data.
// Dispatch unit to VRF unit
// rd_data would be return from VRF at the current cycle.
    output logic [6-1:0][5-1:0] rd_index_dp2vrf;          
    input  logic [6-1:0][128-1:0]                rd_data_vrf2dp;
    input  logic [128-1:0]                                 v0_mask_vrf2dp;

// Dispatch unit accept all ROB entry to determine if vs_data of RS is from ROB or not
// ROB unit to Dispatch unit
    input  ROB2DP_t     [8-1:0]          rob_entry;

// ---internal signal definition--------------------------------------
    SUC_UOP_RAW_t       [3-1:0]   suc_uop;
    PRE_UOP_RAW_t       [8-1:0]    pre_uop_rob;
    PRE_UOP_RAW_t       [3-2:0]   pre_uop_uop;
    RAW_UOP_ROB_t       [3-1:0]   raw_uop_rob; 
    // uop0 is the first uop so no need raw check between uops for it
    RAW_UOP_UOP_t       [3-1:1]   raw_uop_uop; 

    STRCT_UOP_t         [3-1:0]   strct_uop;
    ARCH_HAZARD_t                           arch_hazard;

    UOP_OPN_t           [3-1:0]   uop_operand;
    UOP_OPN_t           [3-1:0]   vrf_byp;
    ROB_BYP_t           [8-1:0]    rob_byp;

    UOP_CTRL_t          [3-1:0]   uop_ctrl;

    UOP_INFO_t          [3-1:0]   uop_info;
    UOP_OPN_BYTE_TYPE_t [3-1:0]   uop_operand_byte_type;

    logic [3-1:0][$clog2(128)+1-1:0]          vlmax;
    logic [3-1:0][$clog2($clog2(128)+1)-1:0]  vlmax_shift;

    logic [3-1:0][$clog2(8)-1:0]   rob_address;

// ---code start------------------------------------------------------
    genvar i;

    // vlmax = lmul * `VLENB / sew 
    generate
      for (i=0; i<3; i++) begin : gen_vlmax
        assign vlmax_shift[i] = ($clog2($clog2(128)+1))'(uop_uop2dp[i].vector_csr.lmul[1:0]) 
                                + $clog2((128/8)) 
                                - ($clog2($clog2(128)+1))'(uop_uop2dp[i].vector_csr.sew) 
                                - {{($clog2($clog2(128)+1)-3){1'b0}},uop_uop2dp[i].vector_csr.lmul[2],2'b0};
        assign vlmax[i] = ($clog2(128)+1)'(1) << vlmax_shift[i];
      end
    endgenerate

    generate
        for (i=0; i<3; i++) begin : gen_suc_uop
            assign suc_uop[i].vs1_index = uop_uop2dp[i].vs1;
            assign suc_uop[i].vs1_valid = uop_uop2dp[i].vs1_valid;
            assign suc_uop[i].vs2_index = uop_uop2dp[i].vs2_index;
            assign suc_uop[i].vs2_valid = uop_uop2dp[i].vs2_valid;
            assign suc_uop[i].vd_index  = uop_uop2dp[i].dst_index;
            assign suc_uop[i].vs3_valid = uop_uop2dp[i].vs3_valid;
            assign suc_uop[i].vm        = uop_uop2dp[i].vm;
        end
    endgenerate
// RAW data hazard check between uop[*] and ROB
    generate
        for (i=0; i<8; i++) begin : gen_pre_uop_rob
            assign pre_uop_rob[i].w_index = rob_entry[i].w_index;
            assign pre_uop_rob[i].w_type  = rob_entry[i].w_type;
            assign pre_uop_rob[i].w_valid = rob_entry[i].w_valid;
            assign pre_uop_rob[i].valid   = rob_entry[i].valid;
        end
        for (i=0; i<3; i++) begin : gen_raw_uop_rob
            rvv_backend_dispatch_raw_uop_rob #(
            ) u_raw_uop_rob (
                .raw_uop_rob  (raw_uop_rob[i]),
                .suc_uop      (suc_uop[i]),
                .pre_uop      (pre_uop_rob)
            );
        end
    endgenerate

// RAW data hazard check between uop(s)
    generate
        for (i=0; i<3-1; i++) begin : gen_pre_uop_uop
            assign pre_uop_uop[i].w_index = uop_uop2dp[i].dst_index;
            assign pre_uop_uop[i].w_valid = 1'b0;
            assign pre_uop_uop[i].w_type  = uop_uop2dp[i].vd_valid ? VRF : XRF;
            assign pre_uop_uop[i].valid   = uop_uop2dp[i].vd_valid & uop_valid_uop2dp[i];
        end
        for (i=1; i<3; i++) begin : gen_raw_uop_uop
            rvv_backend_dispatch_raw_uop_uop #(
                .PREUOP_NUM (i)
            ) u_raw_uop_uop (
                .raw_uop_uop  (raw_uop_uop[i]),
                .suc_uop      (suc_uop[i]),
                .pre_uop      (pre_uop_uop[i-1:0])
            );
        end
    endgenerate

// Structure hazard check and set read index for VRF
    generate
        for (i=0; i<3; i++) begin : gen_strct_uop
            assign strct_uop[i].vs1_index = uop_uop2dp[i].vs1;
            assign strct_uop[i].vs1_valid = uop_uop2dp[i].vs1_valid;
            assign strct_uop[i].vs2_index = uop_uop2dp[i].vs2_index;
            assign strct_uop[i].vs2_valid = uop_uop2dp[i].vs2_valid;
            assign strct_uop[i].vd_index  = uop_uop2dp[i].dst_index;
            assign strct_uop[i].vs3_valid = uop_uop2dp[i].vs3_valid;
            assign strct_uop[i].uop_exe_unit = uop_uop2dp[i].uop_exe_unit;
            assign strct_uop[i].uop_class = uop_uop2dp[i].uop_class;
        end
    endgenerate

    rvv_backend_dispatch_structure_hazard #(
    ) u_structure_hazard (
        .rd_index     (rd_index_dp2vrf),
        .arch_hazard  (arch_hazard),
        .strct_uop    (strct_uop)
    );

// Bypass data for source operand of uop(s)
    generate
      for (i=0; i<8; i++) begin : gen_rob_byp
        assign rob_byp[i].w_data    = rob_entry[i].w_data;
        assign rob_byp[i].byte_type = rob_entry[i].byte_type;

        



          assign rob_byp[i].tail_one  = 1'b0;
          assign rob_byp[i].inactive_one = 1'b0;
        
      end

      rvv_backend_dispatch_operand
      u_operand
      (
        .vrf_byp        (vrf_byp       ),
        .uop_uop2dp     (uop_uop2dp    ),
        .rd_data_vrf2dp (rd_data_vrf2dp),
        .v0_mask_vrf2dp (v0_mask_vrf2dp)
      );

      for (i=0;i<3;i++) begin: gen_bypass_data
        rvv_backend_dispatch_bypass 
        #(
        ) 
        u_bypass (
