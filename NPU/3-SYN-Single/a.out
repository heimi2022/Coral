// handshake singals
    input   logic         [3-1:0] uop_valid_uop2dp;
    output  logic         [3-1:0] uop_ready_dp2uop;

    output  logic         [3-1:0] rs_valid_dp2alu;
    input   logic         [3-1:0] rs_ready_alu2dp;
    output  logic         [3-1:0] rs_valid_dp2pmtrdt;
    input   logic         [3-1:0] rs_ready_pmtrdt2dp;
    output  logic         [3-1:0] rs_valid_dp2mul;
    input   logic         [3-1:0] rs_ready_mul2dp;
    output  logic         [3-1:0] rs_valid_dp2div;
    input   logic         [3-1:0] rs_ready_div2dp;
  



    output  logic         [3-1:0] rs_valid_dp2lsu;
    input   logic         [3-1:0] rs_ready_lsu2dp;
    output  logic         [3-1:0] mapinfo_valid_dp2lsu;
    input   logic         [3-1:0] mapinfo_ready_lsu2dp;

    output  logic         [3-1:0] uop_valid_dp2rob;
    input   logic         [3-1:0] uop_ready_rob2dp;

// ---internal signal definition--------------------------------------
    logic [3-1:0] uop_valid;
    logic [3-1:0] rs_ready;

// ---code start------------------------------------------------------
    genvar i;
    generate
        for (i=0; i<3; i++) begin : gen_uop_valid
            if (i==0) begin : gen_first
              assign uop_valid[0] = uop_valid_uop2dp[0]      &
                                    ~raw_uop_rob[0].vs1_wait &
                                    ~raw_uop_rob[0].vs2_wait &
                                    ~raw_uop_rob[0].vd_wait  &
                                    ~raw_uop_rob[0].v0_wait  ;
            end else if (i<3-1) begin : gen_i
              assign uop_valid[i] = uop_valid[i-1]           &
                                    uop_valid_uop2dp[i]      &
                                    ~raw_uop_rob[i].vs1_wait &
                                    ~raw_uop_rob[i].vs2_wait &
                                    ~raw_uop_rob[i].vd_wait  &
                                    ~raw_uop_rob[i].v0_wait  &
                                    ~raw_uop_uop[i].vs1_wait &
                                    ~raw_uop_uop[i].vs2_wait &
                                    ~raw_uop_uop[i].vd_wait  &
                                    ~raw_uop_uop[i].v0_wait  ;
            end else begin : gen_last
              assign uop_valid[i] = uop_valid[i-1]           &
                                    uop_valid_uop2dp[i]      &
                                    ~raw_uop_rob[i].vs1_wait &
                                    ~raw_uop_rob[i].vs2_wait &
                                    ~raw_uop_rob[i].vd_wait  &
                                    ~raw_uop_rob[i].v0_wait  &
                                    ~raw_uop_uop[i].vs1_wait &
                                    ~raw_uop_uop[i].vs2_wait &
                                    ~raw_uop_uop[i].vd_wait  &
                                    ~raw_uop_uop[i].v0_wait  &
                                    ~arch_hazard.vr_limit    ;  
            end
        end
        for (i=0; i<3; i++) begin : gen_rs_ready
          if (i==0) begin : gen_first
            always_comb begin
                case (uop_ctrl[i].uop_exe_unit)
