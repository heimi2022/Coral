);
// ---port definition-------------------------------------------------
  output  UOP_OPN_t   [3-1:0]             vrf_byp;
  input   UOP_QUEUE_t [3-1:0]             uop_uop2dp;
  input   logic       [6-1:0][128-1:0]  rd_data_vrf2dp;
  input   logic       [128-1:0]                   v0_mask_vrf2dp;

// get the operand from VRF

  always_comb begin
    vrf_byp[0].v0  = v0_mask_vrf2dp;
    vrf_byp[0].vs1 = rd_data_vrf2dp[0];
    vrf_byp[0].vs2 = rd_data_vrf2dp[1];
