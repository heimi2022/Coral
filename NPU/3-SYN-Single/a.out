    .lcmd               (lcmd),
    .uop_index_remain   (uop_index_remain),
    .uop_valid          (uop_valid_ari),
    .uop                (uop_ari)  
  );

  // output
  always_comb begin 
    uop_valid     = 'b0;
    uop           = 'b0;
    
