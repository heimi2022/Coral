    if (reset) begin
      ibusCmd_valid <= 1'h0;
      ibusCmd_bits <= 32'h0;
      fault <= 1'h0;
    end
    else begin
      ibusCmd_valid <= ibusFired;
      ibusCmd_bits <= ibusFired ? io_ctrl_bits : 32'h0;
      fault <= io_ibus_fault_valid;
