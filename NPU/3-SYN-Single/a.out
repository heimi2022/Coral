          end
        // retire_uop data
        


          
          assign rd_rob2rt[i].w_valid         = res_mem[wind_uop_rptr[i]].w_valid & uop_done[wind_uop_rptr[i]];
          assign rd_rob2rt[i].w_index         = uop_rob2rt[i].w_index;
