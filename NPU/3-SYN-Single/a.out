  assign sub_fexcp.dz = sub_status.DZ |fpexp_reg.DZ;
  assign sub_fexcp.of = sub_status.OF |fpexp_reg.OF;
  assign sub_fexcp.uf = sub_status.UF |fpexp_reg.UF;
