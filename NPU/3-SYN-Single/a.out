  TAG_t                                     tag_fma;
  FCMP_TAG_t                                tag_fcmp;
  FCVT_TAG_t                                tag_fcvt;
  TAG_t                                     tag_ftbl;
  // result & arb
  logic     [3:0]                           result_vld;
  logic     [3:0]                           arb_rdy;
  // fma
  logic                                     addmul_result_vld;
  logic     [128-1:0]                     addmul_result;
  fpnew_pkg::status_t [(128/32)-1:0]          addmul_status_o;
  TAG_t                                     addmul_tag_o;
  logic                                     addmul_result_rdy;
  // fcvt
  logic                                     cvt_result_vld;
  logic     [128-1:0]                     cvt_result;
  fpnew_pkg::status_t [(128/32)-1:0]          cvt_status_o;
  FCVT_TAG_t                                cvt_tag_o;
  logic                                     cvt_result_rdy;
  // ftbl
  logic                                     tbl_result_vld;
  logic     [128-1:0]                     tbl_result;
  RVFEXP_t  [(128/32)-1:0]                    tbl_status_o;
  TAG_t                                     tbl_tag_o;
  logic                                     tbl_result_rdy;
  // fcmp&fncmp
  logic                                     allcmp_result_vld_tmp;
  logic                                     allcmp_result_vld;
  logic                                     is_class_o;
  logic     [128-1:0]                     allcmp_unit_res;
  fpnew_pkg::classmask_e  [(128/32)-1:0]      class_result;
  logic     [128-1:0]                     allcmp_result;
  fpnew_pkg::status_t [(128/32)-1:0]          allcmp_status_o;
  FCMP_TAG_t                                allcmp_tag_o;
  logic                                     allcmp_result_rdy_tmp;
  logic                                     allcmp_result_rdy;
  // fcmp info
  logic         [PIPEREGS:0][1:0]           info_vld;
  logic         [PIPEREGS:0]                info_rdy;
  FCMP_INFO_t   [PIPEREGS:0]                cmp_info;
  logic   [128-1:0]                       v0;
  logic   [128-1:0]                       vstart_elements_tmp;
  logic   [128-1:0]                       vstart_elements;
  logic   [128-1:0]                       tail_elements_tmp;
  logic   [128-1:0]                       tail_elements;
  logic   [6:0]                             cmp_en;
  logic   [8*(128/32)-1:0]                    cmp;
  logic   [7*(128/32)-1:0]                    cmp_d1;
  logic   [128-1:0]                       cmp_res_tmp;
  logic   [128-1:0]                       cmp_res;
  RVFEXP_t  [8*(128/32)-1:0]                  cmp_status;
  RVFEXP_t  [7*(128/32)-1:0]                  cmp_status_d1;
  RVFEXP_t  [128-1:0]                     cmp_fexp_tmp;
  RVFEXP_t  [128-1:0]                     cmp_fexp_per1;
  RVFEXP_t  [(128/8)-1:0]                    cmp_fexp;
  RVFEXP_t  [(128/8)-1:0]                    allcmp_fexp;
  
  genvar                                    i;

//
// code start
//
  // valid uop
  assign addmul_vld = fma_uop_vld & fma_type[0];
  assign allcmp_vld = fma_uop_vld & fma_type[1];
  assign cvt_vld    = fma_uop_vld & fma_type[2];
  assign tbl_vld    = fma_uop_vld & fma_type[3];




  assign vd_eew     = EEW32;


  // prepare source data
  always_comb begin
    src1 = fma_uop.vs1_data;
    src2 = fma_uop.vs2_data;
    src3 = fma_uop.vs3_data;
    
    case(fma_uop.uop_funct3)
      OPFVF: begin
        src1 = {(128/32){fma_uop.rs1_data}};
      











      end
    





























    endcase
  end

  // rounding mode
  always_comb begin
    case(fma_uop.frm)
      FRNE:    rnd_mod_dec = fpnew_pkg::RNE;
      FRTZ:    rnd_mod_dec = fpnew_pkg::RTZ;
      FRDN:    rnd_mod_dec = fpnew_pkg::RDN;
      FRUP:    rnd_mod_dec = fpnew_pkg::RUP;
      FRMM:    rnd_mod_dec = fpnew_pkg::RMM;
      default: rnd_mod_dec = fpnew_pkg::DYN;
    endcase
  end

  //decode for instruction
  always_comb begin
    // default
    for(int i=0;i<(128/32);i++) begin
      op_i[i] = {src3[i*32+:32], src2[i*32+:32], src1[i*32+:32]};
    end
    rnd_mod_i = rnd_mod_dec;
    op_type   = fpnew_pkg::FMADD;
    op_mod    = 1'b0;
    src_fmt   = fpnew_pkg::FP32;
    src2_fmt  = fpnew_pkg::FP32;
    dst_fmt   = fpnew_pkg::FP32;
    int_fmt   = fpnew_pkg::INT32;
    
    case(1'b1)
      addmul_vld: begin//ADDMUL
        case(fma_uop.uop_funct6.ari_funct6)
          VFADD: begin
            op_type   = fpnew_pkg::ADD;
            for(int i=0;i<(128/32);i++) begin
              op_i[i] = {src1[i*32+:32], src2[i*32+:32], 32'b0}; 
            end
          end
          VFSUB: begin
            op_type = fpnew_pkg::ADD;
            op_mod  = 1'b1;
            for(int i=0;i<(128/32);i++) begin
              op_i[i] = {src1[i*32+:32], src2[i*32+:32], 32'b0}; 
            end
          end
          VFRSUB: begin
            op_type = fpnew_pkg::ADD;
            op_mod  = 1'b1;
            for(int i=0;i<(128/32);i++) begin
              op_i[i] = {src2[i*32+:32], src1[i*32+:32], 32'b0}; 
            end
          end
          VFMUL: begin
            op_type = fpnew_pkg::MUL;
          end
          VFMACC: begin
            op_type = fpnew_pkg::FMADD;
          end
          VFNMACC: begin
            op_type = fpnew_pkg::FNMSUB;
            op_mod  = 1'b1;
          end
          VFMSAC: begin
            op_type = fpnew_pkg::FMADD;
            op_mod  = 1'b1;
          end
          VFNMSAC: begin
            op_type = fpnew_pkg::FNMSUB;
          end
          VFMADD: begin
            op_type = fpnew_pkg::FMADD;
            for(int i=0;i<(128/32);i++) begin
              op_i[i] = {src2[i*32+:32], src3[i*32+:32], src1[i*32+:32]}; 
            end
          end
          VFNMADD: begin
            op_type = fpnew_pkg::FNMSUB;
            op_mod  = 1'b1;
            for(int i=0;i<(128/32);i++) begin
              op_i[i] = {src2[i*32+:32], src3[i*32+:32], src1[i*32+:32]}; 
            end
          end
          VFMSUB: begin
            op_type = fpnew_pkg::FMADD;
            op_mod  = 1'b1;
            for(int i=0;i<(128/32);i++) begin
              op_i[i] = {src2[i*32+:32], src3[i*32+:32], src1[i*32+:32]}; 
            end
          end
          VFNMSUB: begin
            op_type = fpnew_pkg::FNMSUB;
            for(int i=0;i<(128/32);i++) begin
              op_i[i] = {src2[i*32+:32], src3[i*32+:32], src1[i*32+:32]}; 
            end
          end
        







        endcase
      end
      allcmp_vld: begin//CMP
        case(fma_uop.uop_funct6.ari_funct6)
          VMFEQ: begin
            op_type   = fpnew_pkg::CMP;
            rnd_mod_i = fpnew_pkg::RDN;
          end
          VMFNE:begin 
            op_type   = fpnew_pkg::CMP;
            rnd_mod_i = fpnew_pkg::RDN; 
            op_mod    = 1'b1;
          end
          VMFLT: begin 
            op_type   = fpnew_pkg::CMP;
            rnd_mod_i = fpnew_pkg::RNE; 
            op_mod    = 1'b1;
          end
          VMFLE: begin 
            op_type   = fpnew_pkg::CMP;
            rnd_mod_i = fpnew_pkg::RTZ; 
            op_mod    = 1'b1;
          end
          VMFGT: begin 
            op_type   = fpnew_pkg::CMP;
            rnd_mod_i = fpnew_pkg::RTZ; 
          end
          VMFGE: begin 
            op_type   = fpnew_pkg::CMP;
            rnd_mod_i = fpnew_pkg::RNE; 
          end
          VFSGNJ: begin
            op_type   = fpnew_pkg::SGNJ;
            rnd_mod_i = fpnew_pkg::RNE;
          end
          VFSGNJN: begin
            op_type   = fpnew_pkg::SGNJ;
            rnd_mod_i = fpnew_pkg::RTZ;
          end
          VFSGNJX: begin
            op_type   = fpnew_pkg::SGNJ;
            rnd_mod_i = fpnew_pkg::RDN;
          end
          VFMIN: begin
            op_type   = fpnew_pkg::MINMAX;
            rnd_mod_i = fpnew_pkg::RNE;
          end
          VFMAX: begin
            op_type   = fpnew_pkg::MINMAX;
            rnd_mod_i = fpnew_pkg::RTZ;
          end
          VFUNARY1: begin
            op_type   = fpnew_pkg::CLASSIFY;
            for(int i=0;i<(128/32);i++) begin
              op_i[i] = {32'b0, 32'b0, src2[i*32+:32]}; 
            end
          end
        endcase
      end
      cvt_vld: begin//CVT
        case(fma_uop.vs1)
          VFCVT_XUFV: begin
            op_type   = fpnew_pkg::F2I; 
            op_mod    = 1'b1;
          end
          VFCVT_XFV: begin
            op_type   = fpnew_pkg::F2I; 
          end
          VFCVT_FXUV: begin
            op_type   = fpnew_pkg::I2F;
            op_mod    = 1'b1;
          end
          VFCVT_FXV: begin 
            op_type   = fpnew_pkg::I2F; 
          end
          VFCVT_RTZXUFV: begin
            op_type   = fpnew_pkg::F2I; 
            rnd_mod_i = fpnew_pkg::RTZ;
            op_mod    = 1'b1;
          end
          VFCVT_RTZXFV: begin
            op_type   = fpnew_pkg::F2I; 
            rnd_mod_i = fpnew_pkg::RTZ; 
          end
        











        endcase
      end
    endcase
  end

  // tag






  assign tag_fma.rob_entry          = fma_uop.rob_entry;
  assign tag_fcmp.com_tag.rob_entry = fma_uop.rob_entry;
  assign tag_fcmp.is_fcmp           = fma_uop.uop_exe_unit==FCMP;
  assign tag_fcmp.uop_index         = fma_uop.uop_index;
  assign tag_fcmp.last_uop_valid    = fma_uop.last_uop_valid;
  assign tag_fcvt.com_tag.rob_entry = fma_uop.rob_entry;
  assign tag_fcvt.eew_vd            = vd_eew;
  assign tag_fcvt.uop_index         = fma_uop.uop_index[0];
  assign tag_ftbl.rob_entry         = fma_uop.rob_entry;

  // execution units
  generate
    // sub unit 0
    fpnew_fma_multi #(
      


      .FpFmtConfig        (5'b10000),
      
      .NumPipeRegs        (PIPEREGS),
      .PipeConfig         (fpnew_pkg::DISTRIBUTED),
      .TagType            (TAG_t)
      )
    addmul (
      .clk_i              (clk),
      .rst_ni             (rst_n),
      // Input signals
      .operands_i         (op_i[0]), // 3 operands
      .is_boxed_i         ('1), // 3 operands
      .rnd_mode_i         (rnd_mod_i),
      .op_i               (op_type),
      .op_mod_i           (op_mod),
      .src_fmt_i          (src_fmt),
      .src2_fmt_i         (src2_fmt),
      .dst_fmt_i          (dst_fmt),
      .tag_i              (tag_fma),
      .mask_i             ('0),
      .aux_i              ('0),
      // Input Handshake
      .in_valid_i         (addmul_vld),
      .in_ready_o         (fma_uop_addmul_rdy),
      .flush_i            (trap_flush_rvv),
      // Output signals
      .result_o           (addmul_result[0+:32]), 
      .status_o           (addmul_status_o[0]),          
      .extension_bit_o    (),
      .tag_o              (addmul_tag_o),
      .mask_o             (),
      .aux_o              (),
      // Output handshake
      .out_valid_o        (addmul_result_vld),    
      .out_ready_i        (addmul_result_rdy),    
      // Indication of valid data in flight
      .busy_o             (),
      // External register enable override
      .reg_ena_i          ('0),
      // Early valid for external structural hazard generation
      .early_out_valid_o  ()
    );
  
    fpnew_noncomp #(
      .FpFormat           (fpnew_pkg::FP32),
      .NumPipeRegs        (PIPEREGS),
      .PipeConfig         (fpnew_pkg::DISTRIBUTED),
      .TagType            (FCMP_TAG_t)
    )
    allcmp (
      .clk_i              (clk),
      .rst_ni             (rst_n),
      // Input signals
      .operands_i         ({op_i[0][1], op_i[0][0]}), // 2 operands
      .is_boxed_i         ('1), // 2 operands
      .rnd_mode_i         (rnd_mod_i),
      .op_i               (op_type),
      .op_mod_i           (op_mod),
      .tag_i              (tag_fcmp),
      .mask_i             ('0),
      .aux_i              ('0),
      // Input Handshake
      .in_valid_i         (allcmp_vld),
      .in_ready_o         (fma_uop_cmp_rdy),
      .flush_i            (trap_flush_rvv),
      // Output signals
      .result_o           (allcmp_unit_res[0+:32]),
      .status_o           (allcmp_status_o[0]),
      .extension_bit_o    (),
      .class_mask_o       (class_result[0]),
      .is_class_o         (is_class_o),
      .tag_o              (allcmp_tag_o),
      .mask_o             (),
      .aux_o              (),
      // Output handshake
      .out_valid_o        (allcmp_result_vld_tmp),
      .out_ready_i        (allcmp_result_rdy_tmp),
      // Indication of valid data in flight
      .busy_o             (),
      // External register enable override
      .reg_ena_i          ('0),
      // Early valid for external structural hazard generation
      .early_out_valid_o  ()
    );
  
    fpnew_cast_multi #(
      


      .FpFmtConfig        (5'b10000),
      
      .IntFmtConfig       (4'b1110),
      .NumPipeRegs        (PIPEREGS),
      .PipeConfig         (fpnew_pkg::DISTRIBUTED),
      .TagType            (FCVT_TAG_t)
    )
    cvt (
      .clk_i              (clk),
      .rst_ni             (rst_n),
      // Input signals
      .operands_i         (src2[0+:32]), // 1 operand
      .is_boxed_i         ('1), // 1 operand
      .rnd_mode_i         (rnd_mod_i),
      .op_i               (op_type),
      .op_mod_i           (op_mod),
      .src_fmt_i          (src2_fmt),
      .dst_fmt_i          (dst_fmt),
      .int_fmt_i          (int_fmt),
      .tag_i              (tag_fcvt),
      .mask_i             ('0),
      .aux_i              ('0),
      // Input Handshake
      .in_valid_i         (cvt_vld),
      .in_ready_o         (fma_uop_cvt_rdy),
      .flush_i            (trap_flush_rvv),
      // Output signals
      .result_o           (cvt_result[0+:32]),
      .status_o           (cvt_status_o[0]),
      .extension_bit_o    (),
      .tag_o              (cvt_tag_o),
      .mask_o             (),
      .aux_o              (),
      // Output handshake
      .out_valid_o        (cvt_result_vld),
      .out_ready_i        (cvt_result_rdy),
      // Indication of valid data in flight
      .busy_o             (),
      // External register enable override
      .reg_ena_i          ('0),
      // Early valid for external structural hazard generation
      .early_out_valid_o  ()
    );
  
    rvv_backend_sqrt7_rec7 #(
      .TagType            (TAG_t)
    )
    tbl (
      .clk                (clk),
      .rst_n              (rst_n),
      // Input signals
      .operand_i          (src2[0+:32]), // 1 operand
      .vs1_i              (fma_uop.vs1),
      .rnd_mode_i         (fma_uop.frm),
      .tag_i              (tag_ftbl),         
      // Input Handshake
      .in_valid_i         (tbl_vld),
      .in_ready_o         (fma_uop_tbl_rdy),
      .flush_i            (trap_flush_rvv),
      // Output signals
      .result_o           (tbl_result[0+:32]),   
      .tbl_status_o       (tbl_status_o[0]),
      .tag_o              (tbl_tag_o),
      // Output handshake
      .out_valid_o        (tbl_result_vld),
      .out_ready_i        (tbl_result_rdy)
    );

    for(i=1;i<(128/32);i++) begin:sub_unit      
      fpnew_fma_multi #(
        


        .FpFmtConfig        (5'b10000),
        
        .NumPipeRegs        (PIPEREGS),
        .PipeConfig         (fpnew_pkg::DISTRIBUTED)
        )
      addmul (
        .clk_i              (clk),
        .rst_ni             (rst_n),
        // Input signals
        .operands_i         (op_i[i]), // 3 operands
        .is_boxed_i         ('1), // 3 operands
        .rnd_mode_i         (rnd_mod_i),
        .op_i               (op_type),
        .op_mod_i           (op_mod),
        .src_fmt_i          (src_fmt),
        .src2_fmt_i         (src2_fmt),
        .dst_fmt_i          (dst_fmt),
        .tag_i              ('0),
        .mask_i             ('0),
        .aux_i              ('0),
        // Input Handshake
        .in_valid_i         (addmul_vld),
        .in_ready_o         (),
        .flush_i            (trap_flush_rvv),
        // Output signals
        .result_o           (addmul_result[i*32+:32]), 
        .status_o           (addmul_status_o[i]),          
        .extension_bit_o    (),
        .tag_o              (),
        .mask_o             (),
        .aux_o              (),
        // Output handshake
        .out_valid_o        (),    
        .out_ready_i        (addmul_result_rdy),    
        // Indication of valid data in flight
        .busy_o             (),
        // External register enable override
        .reg_ena_i          ('0),
        // Early valid for external structural hazard generation
        .early_out_valid_o  ()
      );
  
      fpnew_noncomp #(
        .FpFormat           (fpnew_pkg::FP32),
        .NumPipeRegs        (PIPEREGS),
        .PipeConfig         (fpnew_pkg::DISTRIBUTED)
      )
      allcmp (
        .clk_i              (clk),
        .rst_ni             (rst_n),
        // Input signals
        .operands_i         ({op_i[i][1], op_i[i][0]}), // 2 operands
        .is_boxed_i         ('1), // 2 operands
        .rnd_mode_i         (rnd_mod_i),
        .op_i               (op_type),
        .op_mod_i           (op_mod),
        .tag_i              ('0),
        .mask_i             ('0),
        .aux_i              ('0),
        // Input Handshake
        .in_valid_i         (allcmp_vld),
        .in_ready_o         (),
        .flush_i            (trap_flush_rvv),
        // Output signals
        .result_o           (allcmp_unit_res[i*32+:32]),
        .status_o           (allcmp_status_o[i]),
        .extension_bit_o    (),
        .class_mask_o       (class_result[i]),
        .is_class_o         (),
        .tag_o              (),
        .mask_o             (),
        .aux_o              (),
        // Output handshake
        .out_valid_o        (),
        .out_ready_i        (allcmp_result_rdy_tmp),
        // Indication of valid data in flight
        .busy_o             (),
        // External register enable override
        .reg_ena_i          ('0),
        // Early valid for external structural hazard generation
        .early_out_valid_o  ()
      );
  
      fpnew_cast_multi #(
        


        .FpFmtConfig        (5'b10000),
        
        .IntFmtConfig       (4'b1110),
        .NumPipeRegs        (PIPEREGS),
        .PipeConfig         (fpnew_pkg::DISTRIBUTED),
        .TagType            (FCVT_TAG_t)
      )
      cvt (
        .clk_i              (clk),
        .rst_ni             (rst_n),
        // Input signals
        .operands_i         (src2[i*32+:32]), // 1 operand
        .is_boxed_i         ('1), // 1 operand
        .rnd_mode_i         (rnd_mod_i),
        .op_i               (op_type),
        .op_mod_i           (op_mod),
        .src_fmt_i          (src2_fmt),
        .dst_fmt_i          (dst_fmt),
        .int_fmt_i          (int_fmt),
        .tag_i              ('0),
        .mask_i             ('0),
        .aux_i              ('0),
        // Input Handshake
        .in_valid_i         (cvt_vld),
        .in_ready_o         (),
        .flush_i            (trap_flush_rvv),
        // Output signals
        .result_o           (cvt_result[i*32+:32]),
        .status_o           (cvt_status_o[i]),
        .extension_bit_o    (),
        .tag_o              (),
        .mask_o             (),
        .aux_o              (),
        // Output handshake
        .out_valid_o        (),
        .out_ready_i        (cvt_result_rdy),
        // Indication of valid data in flight
        .busy_o             (),
        // External register enable override
        .reg_ena_i          ('0),
        // Early valid for external structural hazard generation
        .early_out_valid_o  ()
      );
  
      rvv_backend_sqrt7_rec7 #(
      )
      tbl (
        .clk                (clk),
        .rst_n              (rst_n),
        // Input signals
        .operand_i          (src2[i*32+:32]), // 1 operand
        .vs1_i              (fma_uop.vs1),
        .rnd_mode_i         (fma_uop.frm),
        .tag_i              ('0),
        // Input Handshake
        .in_valid_i         (tbl_vld),
        .in_ready_o         (),
        .flush_i            (trap_flush_rvv),
        // Output signals
        .result_o           (tbl_result[i*32+:32]),   
        .tbl_status_o       (tbl_status_o[i]),
        .tag_o              (),
        // Output handshake
        .out_valid_o        (),
        .out_ready_i        (tbl_result_rdy)
      );
    end
  endgenerate

  // register some extra information for FCMP instructions.
  assign info_vld[0][0]     = fma_uop_vld&(fma_uop.uop_exe_unit==FCMP);
  assign info_vld[0][1]     = fma_uop_vld&(fma_uop.uop_exe_unit==FNCMP);
  assign info_rdy[PIPEREGS] = allcmp_result_rdy_tmp; 
  assign cmp_info[0].vstart = fma_uop.vstart;
  assign cmp_info[0].vl     = fma_uop.vl;   
  assign cmp_info[0].vm     = fma_uop.vm;
  assign cmp_info[0].v0     = fma_uop.v0_data_valid ? fma_uop.v0_data : '1;
  assign cmp_info[0].vd     = fma_uop.vs3_data;
  
  // info pipeline
  generate
    for(i=0;i<PIPEREGS;i++) begin
      assign info_rdy[i] = !(|info_vld[i+1]) || info_rdy[i+1];
      
      // vld
      cdffr #(
        .T            (logic [1:0])
      ) fcmp_vld_pipe ( 
        .q            (info_vld[i+1]), 
        .clk          (clk), 
        .rst_n        (rst_n),  
        .c            (trap_flush_rvv), 
        .e            (info_rdy[i]), 
        .d            (info_vld[i]) 
      );
      // info for FCMP
      edff # (
        .T            (FCMP_INFO_t)
      ) fcmp_info_pipe ( 
        .q            (cmp_info[i+1]), 
        .clk          (clk), 
        .rst_n        (rst_n),  
        .e            (info_vld[i][0]&info_rdy[i]), 
        .d            (cmp_info[i]) 
      );
    end
    
    always_comb begin
      for(int i=0;i<8;i++) begin
        if(allcmp_tag_o.uop_index==i) begin 
          for(int j=0;j<(128/32);j++) begin
            cmp[i*(128/32)+j]         = allcmp_unit_res[j*32];
            cmp_status[i*(128/32)+j]  = allcmp_status_o[j];
          end
        end
        else begin
          cmp[i*(128/32)+:(128/32)]         = 'b0;
          cmp_status[i*(128/32)+:(128/32)]  = 'b0;
        end
      end
    end
  
    for(i=0;i<7;i++) begin
      assign cmp_en[i] = allcmp_result_vld_tmp&allcmp_tag_o.is_fcmp&(!allcmp_tag_o.last_uop_valid)&(allcmp_tag_o.uop_index==i);

      cdffr # (
        .T            (logic [(128/32)-1:0])
      ) fcmp_res ( 
        .q            (cmp_d1[i*(128/32)+:(128/32)]), 
        .clk          (clk), 
        .rst_n        (rst_n),  
        .c            (allcmp_result_vld_tmp&allcmp_tag_o.is_fcmp&allcmp_tag_o.last_uop_valid&allcmp_result_rdy_tmp | trap_flush_rvv), 
        .e            (cmp_en[i]), 
        .d            (cmp[i*(128/32)+:(128/32)]) 
      );

      cdffr # (
        .T            (RVFEXP_t[(128/32)-1:0])
      ) fcmp_exp ( 
        .q            (cmp_status_d1[i*(128/32)+:(128/32)]),
        .clk          (clk), 
        .rst_n        (rst_n),  
        .c            (allcmp_result_vld_tmp&allcmp_tag_o.is_fcmp&allcmp_tag_o.last_uop_valid&allcmp_result_rdy_tmp | trap_flush_rvv), 
        .e            (cmp_en[i]), 
        .d            (cmp_status[i*(128/32)+:(128/32)]) 
      );
    end

    assign cmp_res_tmp      = {(128-8*(128/32))'(0), cmp[8*(128/32)-1:7*(128/32)], (cmp[7*(128/32)-1:0]|cmp_d1)};
    assign cmp_fexp_tmp     = {((128-8*(128/32))*5)'(0), cmp_status[8*(128/32)-1:7*(128/32)], (cmp_status[7*(128/32)-1:0]|cmp_status_d1)};

    barrel_shifter #(.DATA_WIDTH(128)) 
    u_prestart (.din((128)'('1)), .shift_amount(cmp_info[PIPEREGS].vstart[$clog2(128)-1:0]), .shift_mode(2'b00), .dout(vstart_elements_tmp));
    barrel_shifter #(.DATA_WIDTH(128)) 
    u_tail (.din((128)'('1)), .shift_amount(cmp_info[PIPEREGS].vl[$clog2(128)-1:0]), .shift_mode(2'b00), .dout(tail_elements_tmp));
    
    assign vstart_elements  = ~vstart_elements_tmp;
    assign tail_elements    = cmp_info[PIPEREGS].vl[$clog2(128)] ? 'b0 : tail_elements_tmp;

    assign v0               = {(128-8*(128/32))'(0), cmp_info[PIPEREGS].v0};

    for(i=0;i<128;i++) begin: FCMP_MERGE
      always_comb begin
        if(!(vstart_elements[i]|tail_elements[i]) & (cmp_info[PIPEREGS].vm|v0[i])) begin
          cmp_res[i]        = cmp_res_tmp[i];
          cmp_fexp_per1[i]  = cmp_fexp_tmp[i];
        end
        else begin
          cmp_res[i]        = cmp_info[PIPEREGS].vd[i];
          cmp_fexp_per1[i]  = 'b0;
        end
      end
    end

    for(i=0;i<(128/8);i++) begin
      always_comb begin
        cmp_fexp[i]   = 'b0;
        for(int j=0;j<8;j++) begin
          cmp_fexp[i] = cmp_fexp[i] | cmp_fexp_per1[i*8+j];
        end
      end
    end
  endgenerate

  // final result of allCMP
  always_comb begin
    allcmp_result_vld     = 'b0;
    allcmp_result         = allcmp_unit_res;
    allcmp_result_rdy_tmp = 'b1;
    allcmp_fexp           = 'b0;

    if(allcmp_result_vld_tmp) begin
      if(is_class_o) begin
        allcmp_result_vld     = 'b1;
        allcmp_result_rdy_tmp = allcmp_result_rdy;
        for(int i=0;i<(128/32);i++) begin
          allcmp_result[i*32+:32] = {22'b0, class_result[i]};
          allcmp_fexp[4*i+:4]                       = {4{allcmp_status_o[i]}};
        end
      end
      else if(!allcmp_tag_o.is_fcmp) begin
        allcmp_result_vld     = 'b1;
        allcmp_result         = allcmp_unit_res;
        allcmp_result_rdy_tmp = allcmp_result_rdy;
        for(int i=0;i<(128/32);i++) begin
          allcmp_fexp[4*i+:4] = {4{allcmp_status_o[i]}};
        end
      end
      else if(allcmp_tag_o.last_uop_valid) begin
        allcmp_result_vld     = 'b1;
        allcmp_result         = cmp_res;
        allcmp_result_rdy_tmp = allcmp_result_rdy;
        allcmp_fexp           = cmp_fexp;
      end
    end
  end

  // commit result
  arb_round_robin #(.REQ_NUM(4)) arb2rob (.clk(clk), .rst_n(rst_n), .req(result_vld), .grant(arb_rdy));
  assign result_vld         = fma_result_rdy ? {tbl_result_vld, cvt_result_vld, allcmp_result_vld, addmul_result_vld} : 'b0;
  assign fma_result_vld     = |result_vld;
  assign addmul_result_rdy  = arb_rdy[0];
  assign allcmp_result_rdy  = arb_rdy[1];
  assign cvt_result_rdy     = arb_rdy[2];
  assign tbl_result_rdy     = arb_rdy[3];

  always_comb begin
    fma_result = 'b0;

    case(1'b1)
      arb_rdy[3]: begin//choose look-up table results
      


        fma_result.rob_entry  = tbl_tag_o.rob_entry;
        fma_result.w_valid    = 'b1;
        fma_result.vsaturate  = 'b0;
        fma_result.w_data     = tbl_result;
        for(int i=0;i<(128/32);i++) begin
          fma_result.fpexp[4*i+:4]  = {4{tbl_status_o[i]}};
        end
      end
      arb_rdy[2]: begin//choose cvt results
      


        fma_result.rob_entry  = cvt_tag_o.com_tag.rob_entry;
        fma_result.w_valid    = 'b1;
        fma_result.vsaturate  = 'b0;
        for(int i=0;i<(128/32);i++) begin
        





















          fma_result.w_data[i*32+:32] = cvt_result[i*32+:32];
          fma_result.fpexp[4*i+:4]                      = {4{cvt_status_o[i]}};
        
        end
      end
      arb_rdy[1]: begin //choose allcmp results
      


        fma_result.rob_entry  = allcmp_tag_o.com_tag.rob_entry;
        fma_result.w_valid    = 'b1;
        fma_result.vsaturate  = 'b0;
        fma_result.w_data     = allcmp_result;
        fma_result.fpexp      = allcmp_fexp;
      end
      arb_rdy[0]: begin // addmul results
      


        fma_result.rob_entry  = addmul_tag_o.rob_entry;
        fma_result.w_valid    = 'b1;
        fma_result.vsaturate  = 'b0;
        fma_result.w_data     = addmul_result;
        for(int i=0;i<(128/32);i++) begin
