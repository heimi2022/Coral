);
  parameter WIDTH = 8;
  
  input   logic [WIDTH-1:0]   src1;
  input   logic [WIDTH-1:0]   src2;
  input   logic [WIDTH-1:0]   src3;
  input   logic [WIDTH-1:0]   src4;
  input   logic [WIDTH-1:0]   cin;
