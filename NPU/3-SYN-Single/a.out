    for(int i=0;i<(128/16);i++) begin: VADDSUB_PROD16
      if (opcode==ADDSUB_VADD) 
        {cout16[i],product16[i]} = { ({cout8[2*i+1],product8[2*i+1]} + cout8[2*i]), product8[2*i] };
      else //(opcode==ADDSUB_VSUB)
        {cout16[i],product16[i]} = { ({cout8[2*i+1],product8[2*i+1]} - cout8[2*i]), product8[2*i] };
    end
  end

  always_comb begin
    for(int i=0;i<(128/32);i++) begin: VADDSUB_PROD32
      if (opcode==ADDSUB_VADD) 
        {cout32[i],product32[i]} = { ({cout16[2*i+1],product16[2*i+1]} + cout16[2*i]), product16[2*i] };
      else //(opcode==ADDSUB_VSUB)
        {cout32[i],product32[i]} = { ({cout16[2*i+1],product16[2*i+1]} - cout16[2*i]), product16[2*i] };
    end
  end 

  // rounding result
  always_comb begin
    round8_src  = 'b0;
    round16_src = 'b0;
    round32_src = 'b0;
    round8  = 'b0;
    round16 = 'b0;
    round32 = 'b0;
    
    case(uop_funct6.ari_funct6)
      VAADDU,
      VASUBU: begin
        case(vxrm)
          RNU: begin
            for(int i=0;i<(128/8);i=i+1) begin
              round8_src[i] = {cout8[i], product8[i][8-1:1]};
              round8[i]     = product8[i][0] ? round8_src[i]+1'b1 : round8_src[i];
            end

            for(int i=0;i<(128/16);i=i+1) begin
              round16_src[i] = {cout16[i], product16[i][16-1:1]};
              round16[i]     = product16[i][0] ? round16_src[i]+1'b1 : round16_src[i];
            end

            for(int i=0;i<(128/32);i=i+1) begin
              round32_src[i] = {cout32[i], product32[i][32-1:1]};
              round32[i]     = product32[i][0] ? round32_src[i]+1'b1 : round32_src[i];
            end
          end
          RNE: begin
            for(int i=0;i<(128/8);i=i+1) begin
              round8_src[i] = {cout8[i], product8[i][8-1:1]};
              round8[i]     = product8[i][0]&product8[i][1] ? round8_src[i]+1'b1 : round8_src[i];
            end
    
            for(int i=0;i<(128/16);i=i+1) begin
              round16_src[i] = {cout16[i], product16[i][16-1:1]};
              round16[i]     = product16[i][0]&product16[i][1] ? round16_src[i]+1'b1 : round16_src[i];
            end
    
            for(int i=0;i<(128/32);i=i+1) begin
              round32_src[i] = {cout32[i], product32[i][32-1:1]};
              round32[i]     = product32[i][0]&product32[i][1] ? round32_src[i]+1'b1 : round32_src[i];
            end
          end
          RDN: begin
            for(int i=0;i<(128/8);i=i+1) begin
              round8_src[i] = {cout8[i], product8[i][8-1:1]}; 
              round8[i]     = round8_src[i];
            end
    
            for(int i=0;i<(128/16);i=i+1) begin
              round16_src[i] = {cout16[i], product16[i][16-1:1]}; 
              round16[i]     = round16_src[i];
            end
    
            for(int i=0;i<(128/32);i=i+1) begin
              round32_src[i] = {cout32[i], product32[i][32-1:1]}; 
              round32[i]     = round32_src[i];
            end
          end
          ROD: begin
            for(int i=0;i<(128/8);i=i+1) begin
              round8_src[i] = {cout8[i], product8[i][8-1:1]};
              round8[i]     = (!product8[i][1])&product8[i][0] ? round8_src[i]+1'b1 : round8_src[i];
            end
    
            for(int i=0;i<(128/16);i=i+1) begin
              round16_src[i] = {cout16[i], product16[i][16-1:1]};
              round16[i]     = (!product16[i][1])&product16[i][0] ? round16_src[i]+1'b1 : round16_src[i]; 
            end
    
            for(int i=0;i<(128/32);i=i+1) begin
              round32_src[i] = {cout32[i], product32[i][32-1:1]}; 
              round32[i]     = (!product32[i][1])&product32[i][0] ? round32_src[i]+1'b1 : round32_src[i]; 
            end
          end
        endcase
      end
      VAADD,
      VASUB: begin
        case(vxrm)
          RNU: begin
            for(int i=0;i<(128/8);i=i+1) begin
              round8_src[i] = {src2_sgn[i]^src1_sgn[i] ? (!cout8[i]) : cout8[i], product8[i][8-1:1]};
              round8[i]     = product8[i][0] ? round8_src[i]+1'b1 : round8_src[i];                  
            end
            
            for(int i=0;i<(128/16);i=i+1) begin
              round16_src[i] = {src2_sgn[2*i+1]^src1_sgn[2*i+1] ? (!cout16[i]) : cout16[i], product16[i][16-1:1]};
              round16[i]     = product16[i][0] ? round16_src[i]+1'b1 : round16_src[i]; 
            end

            for(int i=0;i<(128/32);i=i+1) begin
              round32_src[i] = {src2_sgn[4*i+3]^src1_sgn[4*i+3] ? (!cout32[i]) : cout32[i], product32[i][32-1:1]};
              round32[i]     = product32[i][0] ? round32_src[i]+1'b1 : round32_src[i]; 
            end
          end
          RNE: begin
            for(int i=0;i<(128/8);i=i+1) begin
              round8_src[i] = {src2_sgn[i]^src1_sgn[i] ? (!cout8[i]) : cout8[i], product8[i][8-1:1]};
              round8[i]     = product8[i][0]&product8[i][1] ? round8_src[i]+1'b1 : round8_src[i]; 
            end
    
            for(int i=0;i<(128/16);i=i+1) begin
              round16_src[i] = {src2_sgn[2*i+1]^src1_sgn[2*i+1] ? (!cout16[i]) : cout16[i], product16[i][16-1:1]};
              round16[i]     = product16[i][0]&product16[i][1] ? round16_src[i]+1'b1 : round16_src[i]; 
            end
    
            for(int i=0;i<(128/32);i=i+1) begin
              round32_src[i] = {src2_sgn[4*i+3]^src1_sgn[4*i+3] ? (!cout32[i]) : cout32[i], product32[i][32-1:1]};
              round32[i]     = product32[i][0]&product32[i][1] ? round32_src[i]+1'b1 : round32_src[i]; 
            end
          end
          RDN: begin
            for(int i=0;i<(128/8);i=i+1) begin
              round8_src[i] = {src2_sgn[i]^src1_sgn[i] ? (!cout8[i]) : cout8[i], product8[i][8-1:1]}; 
              round8[i]     = round8_src[i];
            end
    
            for(int i=0;i<(128/16);i=i+1) begin
              round16_src[i] = {src2_sgn[2*i+1]^src1_sgn[2*i+1] ? (!cout16[i]) : cout16[i], product16[i][16-1:1]}; 
              round16[i]     = round16_src[i];
            end
    
            for(int i=0;i<(128/32);i=i+1) begin
              round32_src[i] = {src2_sgn[4*i+3]^src1_sgn[4*i+3] ? (!cout32[i]) : cout32[i], product32[i][32-1:1]}; 
              round32[i]     = round32_src[i];
            end
          end
          ROD: begin
            for(int i=0;i<(128/8);i=i+1) begin
              round8_src[i] = {src2_sgn[i]^src1_sgn[i] ? (!cout8[i]) : cout8[i], product8[i][8-1:1]};
              round8[i]     = (!product8[i][1])&product8[i][0] ? round8_src[i]+1'b1 : round8_src[i]; 
            end
    
            for(int i=0;i<(128/16);i=i+1) begin
              round16_src[i] = {src2_sgn[2*i+1]^src1_sgn[2*i+1] ? (!cout16[i]) : cout16[i], product16[i][16-1:1]};
              round16[i]     = (!product16[i][1])&product16[i][0] ? round16_src[i]+1'b1 : round16_src[i]; 
            end
    
            for(int i=0;i<(128/32);i=i+1) begin
              round32_src[i] = {src2_sgn[4*i+3]^src1_sgn[4*i+3] ? (!cout32[i]) : cout32[i], product32[i][32-1:1]};
              round32[i]     = (!product32[i][1])&product32[i][0] ? round32_src[i]+1'b1 : round32_src[i]; 
            end
          end
        endcase
      end
    endcase
  end

  // overflow check
  generate 
    for (j=0;j<(128/32);j++) begin: OVERFLOW
      always_comb begin
        // initial
        addu_upoverflow[   4*j +: 4] = 'b0;
        add_upoverflow[    4*j +: 4] = 'b0;
        add_underoverflow[ 4*j +: 4] = 'b0;
        subu_underoverflow[4*j +: 4] = 'b0;
        sub_upoverflow[    4*j +: 4] = 'b0;
        sub_underoverflow[ 4*j +: 4] = 'b0;
          
        case(vs2_eew)
          EEW8: begin
            addu_upoverflow[4*j +: 4] = {cout8[4*j+3],cout8[4*j+2],cout8[4*j+1],cout8[4*j]};

            add_upoverflow[4*j +: 4] = {
              ((product8[4*j+3][8-1])&(!src2_sgn[4*j+3])&(!src1_sgn[4*j+3])),
              ((product8[4*j+2][8-1])&(!src2_sgn[4*j+2])&(!src1_sgn[4*j+2])),
              ((product8[4*j+1][8-1])&(!src2_sgn[4*j+1])&(!src1_sgn[4*j+1])),
              ((product8[4*j  ][8-1])&(!src2_sgn[4*j  ])&(!src1_sgn[4*j  ]))};

            add_underoverflow[4*j +: 4] = {
              ((!product8[4*j+3][8-1])&(src2_sgn[4*j+3])&(src1_sgn[4*j+3])),
              ((!product8[4*j+2][8-1])&(src2_sgn[4*j+2])&(src1_sgn[4*j+2])),
              ((!product8[4*j+1][8-1])&(src2_sgn[4*j+1])&(src1_sgn[4*j+1])),
              ((!product8[4*j  ][8-1])&(src2_sgn[4*j  ])&(src1_sgn[4*j  ]))};
            
            subu_underoverflow[4*j +: 4] = {cout8[4*j+3],cout8[4*j+2],cout8[4*j+1],cout8[4*j]};

            sub_upoverflow[4*j +: 4] = {
              ((product8[4*j+3][8-1])&(!src2_sgn[4*j+3])&(src1_sgn[4*j+3])),
              ((product8[4*j+2][8-1])&(!src2_sgn[4*j+2])&(src1_sgn[4*j+2])),
              ((product8[4*j+1][8-1])&(!src2_sgn[4*j+1])&(src1_sgn[4*j+1])),
              ((product8[4*j  ][8-1])&(!src2_sgn[4*j  ])&(src1_sgn[4*j  ]))};

            sub_underoverflow[4*j +: 4] = {
              ((!product8[4*j+3][8-1])&(src2_sgn[4*j+3])&(!src1_sgn[4*j+3])),
              ((!product8[4*j+2][8-1])&(src2_sgn[4*j+2])&(!src1_sgn[4*j+2])),
              ((!product8[4*j+1][8-1])&(src2_sgn[4*j+1])&(!src1_sgn[4*j+1])),
              ((!product8[4*j  ][8-1])&(src2_sgn[4*j  ])&(!src1_sgn[4*j  ]))};
          end
          EEW16: begin
            addu_upoverflow[4*j +: 4] = {cout16[2*j+1],1'b0,cout16[2*j],1'b0};

            add_upoverflow[4*j +: 4] = {
              ((product16[2*j+1][16-1])&(!src2_sgn[4*j+3])&(!src1_sgn[4*j+3])),
              1'b0,
              ((product16[2*j  ][16-1])&(!src2_sgn[4*j+1])&(!src1_sgn[4*j+1])),
              1'b0};

            add_underoverflow[4*j +: 4] = {
              ((!product16[2*j+1][16-1])&(src2_sgn[4*j+3])&(src1_sgn[4*j+3])),
              1'b0,
              ((!product16[2*j  ][16-1])&(src2_sgn[4*j+1])&(src1_sgn[4*j+1])),
              1'b0};

            subu_underoverflow[4*j +: 4] = {cout16[2*j+1],1'b0,cout16[2*j],1'b0};

            sub_upoverflow[4*j +: 4] = {
              ((product16[2*j+1][16-1])&(!src2_sgn[4*j+3])&(src1_sgn[4*j+3])),
              1'b0,
              ((product16[2*j  ][16-1])&(!src2_sgn[4*j+1])&(src1_sgn[4*j+1])),
              1'b0};

            sub_underoverflow[4*j +: 4] = {
              ((!product16[2*j+1][16-1])&(src2_sgn[4*j+3])&(!src1_sgn[4*j+3])),
              1'b0,
              ((!product16[2*j  ][16-1])&(src2_sgn[4*j+1])&(!src1_sgn[4*j+1])),
              1'b0};
          end
          EEW32: begin
            addu_upoverflow[4*j +: 4] = {cout32[j],3'b0};

            add_upoverflow[4*j +: 4] = {
              ((product32[j][32-1])&(!src2_sgn[4*j+3])&(!src1_sgn[4*j+3])),
              3'b0};

            add_underoverflow[4*j +: 4] = {
              ((!product32[j][32-1])&(src2_sgn[4*j+3])&(src1_sgn[4*j+3])),
              3'b0};

            subu_underoverflow[4*j +: 4] = {cout32[j],3'b0};

            sub_upoverflow[4*j +: 4] = {
              ((product32[j][32-1])&(!src2_sgn[4*j+3])&(src1_sgn[4*j+3])),
              3'b0};

            sub_underoverflow[4*j +: 4] = {
              ((!product32[j][32-1])&(src2_sgn[4*j+3])&(!src1_sgn[4*j+3])),
              3'b0};
          end
        endcase
      end
    end
  endgenerate

  generate 
    if(CMP_SUPPORT) begin
      always_comb begin
        cmp_tmp = 'b0;
        cmp     = 'b0;
        cmp_en  = 'b0;
        
        for(int i=0;i<(128/32);i++) begin
          // calculate result data
          case(uop_funct6.ari_funct6)
            VMSEQ,
            VMSNE: begin
              case(vs2_eew)
                EEW8: begin
                  cmp_tmp[(4*uop_index  )*(128/32)+i] = |(product8[0*(128/32)+i]);
                  cmp_tmp[(4*uop_index+1)*(128/32)+i] = |(product8[1*(128/32)+i]);
                  cmp_tmp[(4*uop_index+2)*(128/32)+i] = |(product8[2*(128/32)+i]);
                  cmp_tmp[(4*uop_index+3)*(128/32)+i] = |(product8[3*(128/32)+i]);

                  cmp[(4*uop_index  )*(128/32)+i] = (uop_funct6.ari_funct6==VMSNE) ? 
                                                    cmp_tmp[(4*uop_index)*(128/32)+i] : 
                                                    !cmp_tmp[(4*uop_index)*(128/32)+i];
                  cmp[(4*uop_index+1)*(128/32)+i] = (uop_funct6.ari_funct6==VMSNE) ? 
                                                    cmp_tmp[(4*uop_index+1)*(128/32)+i] : 
                                                    !cmp_tmp[(4*uop_index+1)*(128/32)+i];
                  cmp[(4*uop_index+2)*(128/32)+i] = (uop_funct6.ari_funct6==VMSNE) ? 
                                                    cmp_tmp[(4*uop_index+2)*(128/32)+i] : 
                                                    !cmp_tmp[(4*uop_index+2)*(128/32)+i];
                  cmp[(4*uop_index+3)*(128/32)+i] = (uop_funct6.ari_funct6==VMSNE) ? 
                                                    cmp_tmp[(4*uop_index+3)*(128/32)+i] : 
                                                    !cmp_tmp[(4*uop_index+3)*(128/32)+i];

                  cmp_en[uop_index*4 +: 4] = {4{alu_uop_valid&alu_uop.is_cmp&(!last_uop_valid)}};
                end
                EEW16: begin
                  cmp_tmp[(2*uop_index  )*(128/32)+i] = |(product16[0*(128/32)+i]);
                  cmp_tmp[(2*uop_index+1)*(128/32)+i] = |(product16[1*(128/32)+i]);

                  cmp[(2*uop_index  )*(128/32)+i] = (uop_funct6.ari_funct6==VMSNE) ? 
                                                    cmp_tmp[(2*uop_index)*(128/32)+i] : 
                                                    !cmp_tmp[(2*uop_index)*(128/32)+i];
                  cmp[(2*uop_index+1)*(128/32)+i] = (uop_funct6.ari_funct6==VMSNE) ? 
                                                    cmp_tmp[(2*uop_index+1)*(128/32)+i] : 
                                                    !cmp_tmp[(2*uop_index+1)*(128/32)+i];

                  cmp_en[uop_index*2 +: 2] = {2{alu_uop_valid&alu_uop.is_cmp&(!last_uop_valid)}};
                end
                EEW32: begin
                  cmp_tmp[uop_index*(128/32)+i] = |(product32[(128/32)*0+i]);

                  cmp[uop_index*(128/32)+i] = (uop_funct6.ari_funct6==VMSNE) ? 
                                              cmp_tmp[uop_index*(128/32)+i] : 
                                              !cmp_tmp[uop_index*(128/32)+i];

                  cmp_en[uop_index] = alu_uop_valid&alu_uop.is_cmp&(!last_uop_valid);
                end
              endcase
            end
            VMADC,
            VMSBC: begin
              case(vs2_eew)
                EEW8: begin
                  cmp[(4*uop_index  )*(128/32)+i] = cout8[0*(128/32)+i];
                  cmp[(4*uop_index+1)*(128/32)+i] = cout8[1*(128/32)+i];
                  cmp[(4*uop_index+2)*(128/32)+i] = cout8[2*(128/32)+i];
                  cmp[(4*uop_index+3)*(128/32)+i] = cout8[3*(128/32)+i];

                  cmp_en[uop_index*4 +: 4] = {4{alu_uop_valid&alu_uop.is_cmp&(!last_uop_valid)}};
                end
                EEW16: begin
                  cmp[(2*uop_index  )*(128/32)+i] = cout16[0*(128/32)+i];
                  cmp[(2*uop_index+1)*(128/32)+i] = cout16[1*(128/32)+i];

                  cmp_en[uop_index*2 +: 2] = {2{alu_uop_valid&alu_uop.is_cmp&(!last_uop_valid)}};
                end
                EEW32: begin
                  cmp[uop_index*(128/32)+i] = cout32[(128/32)*0+i];

                  cmp_en[uop_index] = alu_uop_valid&alu_uop.is_cmp&(!last_uop_valid);
                end
              endcase
            end
            VMSLT,
            VMSLE,
            VMSGT: begin
              case(vs2_eew)
                EEW8: begin
                  cmp_tmp[(4*uop_index  )*(128/32)+i] = sub_underoverflow[0*(128/32)+i] || 
                                                      (!sub_upoverflow[0*(128/32)+i]) && product8[0*(128/32)+i][8-1];
                  cmp_tmp[(4*uop_index+1)*(128/32)+i] = sub_underoverflow[1*(128/32)+i] || 
                                                      (!sub_upoverflow[1*(128/32)+i]) && product8[1*(128/32)+i][8-1];
                  cmp_tmp[(4*uop_index+2)*(128/32)+i] = sub_underoverflow[2*(128/32)+i] || 
                                                      (!sub_upoverflow[2*(128/32)+i]) && product8[2*(128/32)+i][8-1];
                  cmp_tmp[(4*uop_index+3)*(128/32)+i] = sub_underoverflow[3*(128/32)+i] || 
                                                      (!sub_upoverflow[3*(128/32)+i]) && product8[3*(128/32)+i][8-1];

                  cmp[(4*uop_index  )*(128/32)+i] = (uop_funct6.ari_funct6==VMSLE) ? 
                                                    cmp_tmp[(4*uop_index)*(128/32)+i] | (!(|product8[0*(128/32)+i])) :
                                                    cmp_tmp[(4*uop_index)*(128/32)+i] ;
                  cmp[(4*uop_index+1)*(128/32)+i] = (uop_funct6.ari_funct6==VMSLE) ? 
                                                    cmp_tmp[(4*uop_index+1)*(128/32)+i] | (!(|product8[1*(128/32)+i])) :
                                                    cmp_tmp[(4*uop_index+1)*(128/32)+i] ;
                  cmp[(4*uop_index+2)*(128/32)+i] = (uop_funct6.ari_funct6==VMSLE) ? 
                                                    cmp_tmp[(4*uop_index+2)*(128/32)+i] | (!(|product8[2*(128/32)+i])) :
                                                    cmp_tmp[(4*uop_index+2)*(128/32)+i] ;
                  cmp[(4*uop_index+3)*(128/32)+i] = (uop_funct6.ari_funct6==VMSLE) ? 
                                                    cmp_tmp[(4*uop_index+3)*(128/32)+i] | (!(|product8[3*(128/32)+i])) :
                                                    cmp_tmp[(4*uop_index+3)*(128/32)+i] ;

                  cmp_en[uop_index*4 +: 4] = {4{alu_uop_valid&alu_uop.is_cmp&(!last_uop_valid)}};
                end
                EEW16: begin
                  cmp_tmp[(2*uop_index  )*(128/32)+i] = sub_underoverflow[0*(128/32)+2*i+1] || 
                                                      (!sub_upoverflow[0*(128/32)+2*i+1]) && product16[0*(128/32)+i][16-1];
                  cmp_tmp[(2*uop_index+1)*(128/32)+i] = sub_underoverflow[2*(128/32)+2*i+1] || 
                                                      (!sub_upoverflow[2*(128/32)+2*i+1]) && product16[1*(128/32)+i][16-1];

                  cmp[(2*uop_index  )*(128/32)+i] = (uop_funct6.ari_funct6==VMSLE) ? 
                                                    cmp_tmp[(2*uop_index)*(128/32)+i] | (!(|product16[0*(128/32)+i])) :
                                                    cmp_tmp[(2*uop_index)*(128/32)+i] ;
                  cmp[(2*uop_index+1)*(128/32)+i] = (uop_funct6.ari_funct6==VMSLE) ? 
                                                    cmp_tmp[(2*uop_index+1)*(128/32)+i] | (!(|product16[1*(128/32)+i])) :
                                                    cmp_tmp[(2*uop_index+1)*(128/32)+i] ;

                  cmp_en[uop_index*2 +: 2] = {2{alu_uop_valid&alu_uop.is_cmp&(!last_uop_valid)}};
                end
                EEW32: begin
                  cmp_tmp[uop_index*(128/32)+i] = sub_underoverflow[4*i+3] ||
                                                (!sub_upoverflow[4*i+3]) && product32[i][32-1];

                  cmp[uop_index*(128/32)+i] = (uop_funct6.ari_funct6==VMSLE) ? 
                                              cmp_tmp[uop_index*(128/32)+i] | (!(|product32[i])) :
                                              cmp_tmp[uop_index*(128/32)+i] ;

                  cmp_en[uop_index] = alu_uop_valid&alu_uop.is_cmp&(!last_uop_valid);
                end
              endcase     
            end
            VMSLTU,
            VMSLEU,
            VMSGTU: begin
              case(vs2_eew)
                EEW8: begin
                  cmp_tmp[(4*uop_index  )*(128/32)+i] = subu_underoverflow[0*(128/32)+i] || cout8[0*(128/32)+i];
                  cmp_tmp[(4*uop_index+1)*(128/32)+i] = subu_underoverflow[1*(128/32)+i] || cout8[1*(128/32)+i];
                  cmp_tmp[(4*uop_index+2)*(128/32)+i] = subu_underoverflow[2*(128/32)+i] || cout8[2*(128/32)+i];
                  cmp_tmp[(4*uop_index+3)*(128/32)+i] = subu_underoverflow[3*(128/32)+i] || cout8[3*(128/32)+i];

                  cmp[(4*uop_index  )*(128/32)+i] = (uop_funct6.ari_funct6==VMSLEU) ? 
                                                    cmp_tmp[(4*uop_index)*(128/32)+i] | (!(|product8[0*(128/32)+i])) :
                                                    cmp_tmp[(4*uop_index)*(128/32)+i] ;
                  cmp[(4*uop_index+1)*(128/32)+i] = (uop_funct6.ari_funct6==VMSLEU) ? 
                                                    cmp_tmp[(4*uop_index+1)*(128/32)+i] | (!(|product8[1*(128/32)+i])) :
                                                    cmp_tmp[(4*uop_index+1)*(128/32)+i] ;
                  cmp[(4*uop_index+2)*(128/32)+i] = (uop_funct6.ari_funct6==VMSLEU) ? 
                                                    cmp_tmp[(4*uop_index+2)*(128/32)+i] | (!(|product8[2*(128/32)+i])) :
                                                    cmp_tmp[(4*uop_index+2)*(128/32)+i] ;
                  cmp[(4*uop_index+3)*(128/32)+i] = (uop_funct6.ari_funct6==VMSLEU) ? 
                                                    cmp_tmp[(4*uop_index+3)*(128/32)+i] | (!(|product8[3*(128/32)+i])) :
                                                    cmp_tmp[(4*uop_index+3)*(128/32)+i] ;

                  cmp_en[uop_index*4 +: 4] = {4{alu_uop_valid&alu_uop.is_cmp&(!last_uop_valid)}};
                end
                EEW16: begin
                  cmp_tmp[(2*uop_index  )*(128/32)+i] = subu_underoverflow[0*(128/32)+2*i+1] || cout16[0*(128/32)+i];
                  cmp_tmp[(2*uop_index+1)*(128/32)+i] = subu_underoverflow[2*(128/32)+2*i+1] || cout16[1*(128/32)+i];

                  cmp[(2*uop_index  )*(128/32)+i] = (uop_funct6.ari_funct6==VMSLEU) ? 
                                                    cmp_tmp[(2*uop_index)*(128/32)+i] | (!(|product16[0*(128/32)+i])) :
                                                    cmp_tmp[(2*uop_index)*(128/32)+i] ;
                  cmp[(2*uop_index+1)*(128/32)+i] = (uop_funct6.ari_funct6==VMSLEU) ? 
                                                    cmp_tmp[(2*uop_index+1)*(128/32)+i] | (!(|product16[1*(128/32)+i])) :
                                                    cmp_tmp[(2*uop_index+1)*(128/32)+i] ;

                  cmp_en[uop_index*2 +: 2] = {2{alu_uop_valid&alu_uop.is_cmp&(!last_uop_valid)}};
                end
                EEW32: begin
                  cmp_tmp[uop_index*(128/32)+i] = subu_underoverflow[4*i+3] || cout32[i];

                  cmp[uop_index*(128/32)+i] = (uop_funct6.ari_funct6==VMSLEU) ? 
                                              cmp_tmp[uop_index*(128/32)+i] | (!(|product32[i])) :
                                              cmp_tmp[uop_index*(128/32)+i] ;

                  cmp_en[uop_index] = alu_uop_valid&alu_uop.is_cmp&(!last_uop_valid);
                end
              endcase  
            end
          endcase
        end
      end

      for(j=0;j<28;j++) begin
        cdffr # (
          .T            (logic [(128/32)-1:0])
        ) cmp_pipe ( 
          .q            (cmp_d1[j*(128/32) +: (128/32)]), 
          .clk          (clk), 
          .rst_n        (rst_n),  
          .c            (alu_uop_valid&is_cmp&last_uop_valid | trap_flush_rvv), 
          .e            (cmp_en[j]), 
          .d            (cmp[j*(128/32) +: (128/32)]) 
        );
      end

      assign cmp_res_tmp      = {cmp[128-1:28*(128/32)], (cmp[28*(128/32)-1:0]|cmp_d1)};

      barrel_shifter #(.DATA_WIDTH(128)) 
      u_prestart (.din((128)'('1)), .shift_amount(vstart[$clog2(128)-1:0]), .shift_mode(2'b00), .dout(vstart_elements_tmp));
      barrel_shifter #(.DATA_WIDTH(128)) 
      u_tail (.din((128)'('1)), .shift_amount(vl[$clog2(128)-1:0]), .shift_mode(2'b00), .dout(tail_elements_tmp));
      
      assign vstart_elements  = ~vstart_elements_tmp;
      assign tail_elements    = vl[$clog2(128)] ? 'b0 : tail_elements_tmp;

      for(j=0;j<128;j++) begin: CMP_MERGE
        assign cmp_res[j]       = !(vstart_elements[j]|tail_elements[j]) & (vm|v0_data[j]) ? cmp_res_tmp[j] : vd_data[j];
        assign vmadcsbc_res[j]  = vstart_elements[j]|tail_elements[j] ? vd_data[j] : cmp_res_tmp[j];
      end
    end

    // assign to result_data
    for (j=0;j<(128/32);j++) begin: GET_RESULT_DATA
      always_comb begin
        // initial the data
        result_data[j*32 +: 32] = alu_uop.w_data[j*32 +: 32];
        result_minmax8[4*j+3]  = 'b0;
        result_minmax8[4*j+2]  = 'b0;
        result_minmax8[4*j+1]  = 'b0;
        result_minmax8[4*j]    = 'b0;
        result_minmax16[2*j+1] = 'b0;
        result_minmax16[2*j]   = 'b0;
        result_minmax32[j]     = 'b0;
 
        if(CMP_SUPPORT) begin
          // calculate result data
          case(uop_funct3) 
            OPIVV,
            OPIVX,
            OPIVI: begin
              case(uop_funct6.ari_funct6)
                VADD,
                VSUB,
                VRSUB,
                VADC,
                VSBC: begin
                  case(vs2_eew)
                    EEW8: begin
                      result_data[j*32 +: 32] = {product8[4*j+3],product8[4*j+2],product8[4*j+1],product8[4*j]};
                    end
                    EEW16: begin
                      result_data[j*32 +: 32] = {product16[2*j+1],product16[2*j]};
                    end
                    EEW32: begin
                      result_data[j*32 +: 32] = product32[j];
                    end
                  endcase
                end
                
                VSADDU: begin
                  case(vs2_eew)
                    EEW8: begin
                      if(addu_upoverflow[4*j])
                        result_data[j*32 +: 8] = 'hff;
                      else
                        result_data[j*32 +: 8] = product8[4*j];
                        
                      if(addu_upoverflow[4*j+1])
                        result_data[j*32+1*8 +: 8] = 'hff;
                      else
                        result_data[j*32+1*8 +: 8] = product8[4*j+1];
                      
                      if(addu_upoverflow[4*j+2])
                        result_data[j*32+2*8 +: 8] = 'hff;
                      else
                        result_data[j*32+2*8 +: 8] = product8[4*j+2];

                      if(addu_upoverflow[4*j+3])
                        result_data[j*32+3*8 +: 8] = 'hff;
                      else
                        result_data[j*32+3*8 +: 8] = product8[4*j+3];
                    end
                    EEW16: begin
                      if(addu_upoverflow[4*j+1])
                        result_data[j*32 +: 16] = 'hffff;
                      else
                        result_data[j*32 +: 16] = product16[2*j];
                        
                      if(addu_upoverflow[4*j+3])
                        result_data[j*32+1*16 +: 16] = 'hffff;
                      else
                        result_data[j*32+1*16 +: 16] = product16[2*j+1];
                    end
                    EEW32: begin
                      if(addu_upoverflow[4*j+3])
                        result_data[j*32 +: 32] = 'hffff_ffff;
                      else
                        result_data[j*32 +: 32] = product32[j];
                    end
                  endcase
                end

                VSADD: begin
                  case(vs2_eew)
                    EEW8: begin
                      if (add_upoverflow[4*j])
                        result_data[j*32 +: 8] = 'h7f;
                      else if (add_underoverflow[4*j])
                        result_data[j*32 +: 8] = 'h80;
                      else
                        result_data[j*32 +: 8] = product8[4*j];
                        
                      if (add_upoverflow[4*j+1])
                        result_data[j*32+1*8 +: 8] = 'h7f;
                      else if (add_underoverflow[4*j+1])
                        result_data[j*32+1*8 +: 8] = 'h80;
                      else
                        result_data[j*32+1*8 +: 8] = product8[4*j+1];
                      
                      if (add_upoverflow[4*j+2])
                        result_data[j*32+2*8 +: 8] = 'h7f;
                      else if (add_underoverflow[4*j+2])
                        result_data[j*32+2*8 +: 8] = 'h80;
                      else
                        result_data[j*32+2*8 +: 8] = product8[4*j+2];

                      if (add_upoverflow[4*j+3])
                        result_data[j*32+3*8 +: 8] = 'h7f;
                      else if (add_underoverflow[4*j+3])
                        result_data[j*32+3*8 +: 8] = 'h80;
                      else
                        result_data[j*32+3*8 +: 8] = product8[4*j+3];
                    end
                    EEW16: begin
                      if (add_upoverflow[4*j+1])
                        result_data[j*32 +: 16] = 'h7fff;
                      else if (add_underoverflow[4*j+1])
                        result_data[j*32 +: 16] = 'h8000;
                      else
                        result_data[j*32 +: 16] = product16[2*j];                   

                      if (add_upoverflow[4*j+3])
                        result_data[j*32+1*16 +: 16] = 'h7fff;
                      else if (add_underoverflow[4*j+3])
                        result_data[j*32+1*16 +: 16] = 'h8000;
                      else
                        result_data[j*32+1*16 +: 16] = product16[2*j+1];                   
                    end
                    EEW32: begin
                      if (add_upoverflow[4*j+3])
                        result_data[j*32 +: 32] = 'h7fff_ffff;
                      else if (add_underoverflow[4*j+3])
                        result_data[j*32 +: 32] = 'h8000_0000;
                      else
                        result_data[j*32 +: 32] = product32[j]; 
                    end
                  endcase
                end

                VSSUBU: begin
                  case(vs2_eew)
                    EEW8: begin
                      if(subu_underoverflow[4*j])
                        result_data[j*32 +: 8] = 'd0;
                      else
                        result_data[j*32 +: 8] = product8[4*j];
                        
                      if(subu_underoverflow[4*j+1])
                        result_data[j*32+1*8 +: 8] = 'd0;
                      else
                        result_data[j*32+1*8 +: 8] = product8[4*j+1];
                      
                      if(subu_underoverflow[4*j+2])
                        result_data[j*32+2*8 +: 8] = 'd0;
                      else
                        result_data[j*32+2*8 +: 8] = product8[4*j+2];

                      if(subu_underoverflow[4*j+3])
                        result_data[j*32+3*8 +: 8] = 'd0;
                      else
                        result_data[j*32+3*8 +: 8] = product8[4*j+3];
                    end
                    EEW16: begin
                      if(subu_underoverflow[4*j+1])
                        result_data[j*32 +: 16] = 'd0;
                      else
                        result_data[j*32 +: 16] = product16[2*j];
                        
                      if(subu_underoverflow[4*j+3])
                        result_data[j*32+1*16 +: 16] = 'd0;
                      else
                        result_data[j*32+1*16 +: 16] = product16[2*j+1];
                    end
                    EEW32: begin
                      if(subu_underoverflow[4*j+3])
                        result_data[j*32 +: 32] = 'd0;
                      else
                        result_data[j*32 +: 32] = product32[j];
                    end
                  endcase
                end

                VSSUB: begin
                  case(vs2_eew)
                    EEW8: begin
                      if (sub_upoverflow[4*j])
                        result_data[j*32 +: 8] = 'h7f;
                      else if (sub_underoverflow[4*j])
                        result_data[j*32 +: 8] = 'h80;
                      else
                        result_data[j*32 +: 8] = product8[4*j];
                        
                      if (sub_upoverflow[4*j+1])
                        result_data[j*32+1*8 +: 8] = 'h7f;
                      else if (sub_underoverflow[4*j+1])
                        result_data[j*32+1*8 +: 8] = 'h80;
                      else
                        result_data[j*32+1*8 +: 8] = product8[4*j+1];
                      
                      if (sub_upoverflow[4*j+2])
                        result_data[j*32+2*8 +: 8] = 'h7f;
                      else if (sub_underoverflow[4*j+2])
                        result_data[j*32+2*8 +: 8] = 'h80;
                      else
                        result_data[j*32+2*8 +: 8] = product8[4*j+2];

                      if (sub_upoverflow[4*j+3])
                        result_data[j*32+3*8 +: 8] = 'h7f;
                      else if (sub_underoverflow[4*j+3])
                        result_data[j*32+3*8 +: 8] = 'h80;
                      else
                        result_data[j*32+3*8 +: 8] = product8[4*j+3];
                    end
                    EEW16: begin
                      if (sub_upoverflow[4*j+1])
                        result_data[j*32 +: 16] = 'h7fff;
                      else if (sub_underoverflow[4*j+1])
                        result_data[j*32 +: 16] = 'h8000;
                      else
                        result_data[j*32 +: 16] = product16[2*j];                   

                      if (sub_upoverflow[4*j+3])
                        result_data[j*32+1*16 +: 16] = 'h7fff;
                      else if (sub_underoverflow[4*j+3])
                        result_data[j*32+1*16 +: 16] = 'h8000;
                      else
                        result_data[j*32+1*16 +: 16] = product16[2*j+1];                   
                    end
                    EEW32: begin
                      if (sub_upoverflow[4*j+3])
                        result_data[j*32 +: 32] = 'h7fff_ffff;
                      else if (sub_underoverflow[4*j+3])
                        result_data[j*32 +: 32] = 'h8000_0000;
                      else
                        result_data[j*32 +: 32] = product32[j]; 
                    end
                  endcase
                end

                VMADC,
                VMSBC: begin
                  result_data[j*32 +: 32] = vmadcsbc_res[j*32 +: 32];
                end

                VMSEQ,
                VMSNE,
                VMSLTU,
                VMSLT,
                VMSLEU,
                VMSLE,
                VMSGTU,
                VMSGT: begin
                  result_data[j*32 +: 32] = cmp_res[j*32 +: 32];
                end

                VMINU: begin
                  case(vs2_eew)
                    EEW8: begin
                      result_minmax8[4*j+3] = cout8[4*j+3] ? src2_data[4*j+3] : src1_data[4*j+3];
                      result_minmax8[4*j+2] = cout8[4*j+2] ? src2_data[4*j+2] : src1_data[4*j+2];
                      result_minmax8[4*j+1] = cout8[4*j+1] ? src2_data[4*j+1] : src1_data[4*j+1];
                      result_minmax8[4*j  ] = cout8[4*j  ] ? src2_data[4*j  ] : src1_data[4*j  ];

                      result_data[j*32 +: 32] = {result_minmax8[4*j+3],
                                                                   result_minmax8[4*j+2],
                                                                   result_minmax8[4*j+1],
                                                                   result_minmax8[4*j]};
                    end
                    EEW16: begin
                      result_minmax16[2*j+1] = cout16[2*j+1] ? {src2_data[4*j+3],src2_data[4*j+2]} : {src1_data[4*j+3],src1_data[4*j+2]}; 
                      result_minmax16[2*j  ] = cout16[2*j  ] ? {src2_data[4*j+1],src2_data[4*j  ]} : {src1_data[4*j+1],src1_data[4*j  ]};

                      result_data[j*32 +: 32] = {result_minmax16[2*j+1],
                                                                   result_minmax16[2*j]};
                    end
                    EEW32: begin
                      result_minmax32[j] = cout32[j] ? {src2_data[4*j+3],src2_data[4*j+2],src2_data[4*j+1],src2_data[4*j]}: 
                                                       {src1_data[4*j+3],src1_data[4*j+2],src1_data[4*j+1],src1_data[4*j]}; 

                      result_data[j*32 +: 32] = result_minmax32[j];
                    end
                  endcase
                end

                VMIN: begin
                  case(vs2_eew)
                    EEW8: begin
                      case({src2_data[4*j][8-1],src1_data[4*j][8-1]})
                        2'b10  : result_minmax8[4*j] = src2_data[4*j];
                        2'b01  : result_minmax8[4*j] = src1_data[4*j];
                        default: result_minmax8[4*j] = product8[4*j][8-1] ? src2_data[4*j] : src1_data[4*j];
                      endcase

                      case({src2_data[4*j+1][8-1],src1_data[4*j+1][8-1]})
                        2'b10  : result_minmax8[4*j+1] = src2_data[4*j+1];
                        2'b01  : result_minmax8[4*j+1] = src1_data[4*j+1];
                        default: result_minmax8[4*j+1] = product8[4*j+1][8-1] ? src2_data[4*j+1] : src1_data[4*j+1];
                      endcase

                      case({src2_data[4*j+2][8-1],src1_data[4*j+2][8-1]})
                        2'b10  : result_minmax8[4*j+2] = src2_data[4*j+2];
                        2'b01  : result_minmax8[4*j+2] = src1_data[4*j+2];
                        default: result_minmax8[4*j+2] = product8[4*j+2][8-1] ? src2_data[4*j+2] : src1_data[4*j+2];
                      endcase

                      case({src2_data[4*j+3][8-1],src1_data[4*j+3][8-1]})
                        2'b10  : result_minmax8[4*j+3] = src2_data[4*j+3];
                        2'b01  : result_minmax8[4*j+3] = src1_data[4*j+3];
                        default: result_minmax8[4*j+3] = product8[4*j+3][8-1] ? src2_data[4*j+3] : src1_data[4*j+3];
                      endcase

                      result_data[j*32 +: 32] = {result_minmax8[4*j+3],
                                                                   result_minmax8[4*j+2],
                                                                   result_minmax8[4*j+1],
                                                                   result_minmax8[4*j]};
                    end
                    EEW16: begin
                      case({src2_data[4*j+1][8-1],src1_data[4*j+1][8-1]})
                        2'b10  : result_minmax16[2*j] = {src2_data[4*j+1],src2_data[4*j]};
                        2'b01  : result_minmax16[2*j] = {src1_data[4*j+1],src1_data[4*j]};
                        default: result_minmax16[2*j] = product16[2*j][16-1] ? {src2_data[4*j+1],src2_data[4*j]} : {src1_data[4*j+1],src1_data[4*j]};
                      endcase

                      case({src2_data[4*j+3][8-1],src1_data[4*j+3][8-1]})
                        2'b10  : result_minmax16[2*j+1] = {src2_data[4*j+3],src2_data[4*j+2]};
                        2'b01  : result_minmax16[2*j+1] = {src1_data[4*j+3],src1_data[4*j+2]};
                        default: result_minmax16[2*j+1] = product16[2*j+1][16-1] ? {src2_data[4*j+3],src2_data[4*j+2]} : {src1_data[4*j+3],src1_data[4*j+2]};
                      endcase

                      result_data[j*32 +: 32] = {result_minmax16[2*j+1],
                                                                   result_minmax16[2*j]};
                    end
                    EEW32: begin
                      case({src2_data[4*j+3][8-1],src1_data[4*j+3][8-1]})
                        2'b10  : result_minmax32[j] = {src2_data[4*j+3],src2_data[4*j+2],src2_data[4*j+1],src2_data[4*j]};
                        2'b01  : result_minmax32[j] = {src1_data[4*j+3],src1_data[4*j+2],src1_data[4*j+1],src1_data[4*j]};
                        default: result_minmax32[j] = product32[j][32-1] ? 
                                                        {src2_data[4*j+3],src2_data[4*j+2],src2_data[4*j+1],src2_data[4*j]}:
                                                        {src1_data[4*j+3],src1_data[4*j+2],src1_data[4*j+1],src1_data[4*j]}; 
                      endcase

                      result_data[j*32 +: 32] = result_minmax32[j];
                    end
                  endcase
                end

                VMAXU: begin
                  case(vs2_eew)
                    EEW8: begin
                      result_minmax8[4*j+3] = cout8[4*j+3] ? src1_data[4*j+3] : src2_data[4*j+3];
                      result_minmax8[4*j+2] = cout8[4*j+2] ? src1_data[4*j+2] : src2_data[4*j+2];
                      result_minmax8[4*j+1] = cout8[4*j+1] ? src1_data[4*j+1] : src2_data[4*j+1];
                      result_minmax8[4*j  ] = cout8[4*j  ] ? src1_data[4*j  ] : src2_data[4*j  ];

                      result_data[j*32 +: 32] = {result_minmax8[4*j+3],
                                                                   result_minmax8[4*j+2],
                                                                   result_minmax8[4*j+1],
                                                                   result_minmax8[4*j]};
                    end
                    EEW16: begin
                      result_minmax16[2*j+1] = cout16[2*j+1] ? {src1_data[4*j+3],src1_data[4*j+2]} : {src2_data[4*j+3],src2_data[4*j+2]}; 
                      result_minmax16[2*j  ] = cout16[2*j  ] ? {src1_data[4*j+1],src1_data[4*j  ]} : {src2_data[4*j+1],src2_data[4*j  ]};

                      result_data[j*32 +: 32] = {result_minmax16[2*j+1],
                                                                   result_minmax16[2*j]};
                    end
                    EEW32: begin
                      result_minmax32[j] = cout32[j] ? {src1_data[4*j+3],src1_data[4*j+2],src1_data[4*j+1],src1_data[4*j]}: 
                                                       {src2_data[4*j+3],src2_data[4*j+2],src2_data[4*j+1],src2_data[4*j]}; 

                      result_data[j*32 +: 32] = result_minmax32[j];
                    end
                  endcase
                end

                VMAX: begin
                  case(vs2_eew)
                    EEW8: begin
                      case({src2_data[4*j][8-1],src1_data[4*j][8-1]})
                        2'b01  : result_minmax8[4*j] = src2_data[4*j];
                        2'b10  : result_minmax8[4*j] = src1_data[4*j];
                        default: result_minmax8[4*j] = product8[4*j][8-1] ? src1_data[4*j] : src2_data[4*j];
                      endcase

                      case({src2_data[4*j+1][8-1],src1_data[4*j+1][8-1]})
                        2'b01  : result_minmax8[4*j+1] = src2_data[4*j+1];
                        2'b10  : result_minmax8[4*j+1] = src1_data[4*j+1];
                        default: result_minmax8[4*j+1] = product8[4*j+1][8-1] ? src1_data[4*j+1] : src2_data[4*j+1];
                      endcase

                      case({src2_data[4*j+2][8-1],src1_data[4*j+2][8-1]})
                        2'b01  : result_minmax8[4*j+2] = src2_data[4*j+2];
                        2'b10  : result_minmax8[4*j+2] = src1_data[4*j+2];
                        default: result_minmax8[4*j+2] = product8[4*j+2][8-1] ? src1_data[4*j+2] : src2_data[4*j+2];
                      endcase

                      case({src2_data[4*j+3][8-1],src1_data[4*j+3][8-1]})
                        2'b01  : result_minmax8[4*j+3] = src2_data[4*j+3];
                        2'b10  : result_minmax8[4*j+3] = src1_data[4*j+3];
                        default: result_minmax8[4*j+3] = product8[4*j+3][8-1] ? src1_data[4*j+3] : src2_data[4*j+3];
                      endcase

                      result_data[j*32 +: 32] = {result_minmax8[4*j+3],
                                                                   result_minmax8[4*j+2],
                                                                   result_minmax8[4*j+1],
                                                                   result_minmax8[4*j]};
                    end
                    EEW16: begin
                      case({src2_data[4*j+1][8-1],src1_data[4*j+1][8-1]})
                        2'b01  : result_minmax16[2*j] = {src2_data[4*j+1],src2_data[4*j]};
                        2'b10  : result_minmax16[2*j] = {src1_data[4*j+1],src1_data[4*j]};
                        default: result_minmax16[2*j] = product16[2*j][16-1] ? {src1_data[4*j+1],src1_data[4*j]} : {src2_data[4*j+1],src2_data[4*j]};
                      endcase

                      case({src2_data[4*j+3][8-1],src1_data[4*j+3][8-1]})
                        2'b01  : result_minmax16[2*j+1] = {src2_data[4*j+3],src2_data[4*j+2]};
                        2'b10  : result_minmax16[2*j+1] = {src1_data[4*j+3],src1_data[4*j+2]};
                        default: result_minmax16[2*j+1] = product16[2*j+1][16-1] ? {src1_data[4*j+3],src1_data[4*j+2]} : {src2_data[4*j+3],src2_data[4*j+2]};
                      endcase

                      result_data[j*32 +: 32] = {result_minmax16[2*j+1],
                                                                   result_minmax16[2*j]};
                    end
                    EEW32: begin
                      case({src2_data[4*j+3][8-1],src1_data[4*j+3][8-1]})
                        2'b01  : result_minmax32[j] = {src2_data[4*j+3],src2_data[4*j+2],src2_data[4*j+1],src2_data[4*j]};
                        2'b10  : result_minmax32[j] = {src1_data[4*j+3],src1_data[4*j+2],src1_data[4*j+1],src1_data[4*j]};
                        default: result_minmax32[j] = product32[j][32-1] ? 
                                                        {src1_data[4*j+3],src1_data[4*j+2],src1_data[4*j+1],src1_data[4*j]}:
                                                        {src2_data[4*j+3],src2_data[4*j+2],src2_data[4*j+1],src2_data[4*j]}; 
                      endcase

                      result_data[j*32 +: 32] = result_minmax32[j];
                    end
                  endcase
                end        
              endcase
            end
            
            OPMVV,
            OPMVX: begin
              case(uop_funct6.ari_funct6)
                VWADDU,
                VWSUBU,
                VWADD,
                VWSUB: begin
                  case(vs2_eew)
                    EEW8: begin
                      result_data[j*32 +: 32] = {product16[2*j+1], product16[2*j]};
                    end
                    EEW16: begin
                      result_data[j*32 +: 32] = product32[j];
                    end
                  endcase
                end

                VWADDU_W,
                VWSUBU_W,
                VWADD_W,
                VWSUB_W: begin
                  case(vs2_eew)
                    EEW16: begin
                      result_data[j*32 +: 32] = {product16[2*j+1], product16[2*j]};
                    end
                    EEW32: begin
                      result_data[j*32 +: 32] = product32[j];
                    end
                  endcase
                end

                VAADDU,
                VAADD,
                VASUBU,
                VASUB: begin
                  case(vs2_eew)
                    EEW8: begin
                      result_data[j*32 +: 32] = {round8[4*j+3], round8[4*j+2], round8[4*j+1], round8[4*j]};
                    end
                    EEW16: begin
                      result_data[j*32 +: 32] = {round16[2*j+1], round16[2*j]};
                    end
                    EEW32: begin
                      result_data[j*32 +: 32] = round32[j];
                    end
                  endcase
                end
              endcase
            end
          endcase
        end
        else begin
          // calculate result data
          case(uop_funct3) 
            OPIVV,
            OPIVX,
            OPIVI: begin
              case(uop_funct6.ari_funct6)
                VADD,
                VSUB,
                VRSUB,
                VADC,
                VSBC: begin
                  case(vs2_eew)
                    EEW8: begin
                      result_data[j*32 +: 32] = {product8[4*j+3],product8[4*j+2],product8[4*j+1],product8[4*j]};
                    end
                    EEW16: begin
                      result_data[j*32 +: 32] = {product16[2*j+1],product16[2*j]};
                    end
                    EEW32: begin
                      result_data[j*32 +: 32] = product32[j];
                    end
                  endcase
                end
                
                VSADDU: begin
                  case(vs2_eew)
                    EEW8: begin
                      if(addu_upoverflow[4*j])
                        result_data[j*32 +: 8] = 'hff;
                      else
                        result_data[j*32 +: 8] = product8[4*j];
                        
                      if(addu_upoverflow[4*j+1])
                        result_data[j*32+1*8 +: 8] = 'hff;
                      else
                        result_data[j*32+1*8 +: 8] = product8[4*j+1];
                      
                      if(addu_upoverflow[4*j+2])
                        result_data[j*32+2*8 +: 8] = 'hff;
                      else
                        result_data[j*32+2*8 +: 8] = product8[4*j+2];

                      if(addu_upoverflow[4*j+3])
                        result_data[j*32+3*8 +: 8] = 'hff;
                      else
                        result_data[j*32+3*8 +: 8] = product8[4*j+3];
                    end
                    EEW16: begin
                      if(addu_upoverflow[4*j+1])
                        result_data[j*32 +: 16] = 'hffff;
                      else
                        result_data[j*32 +: 16] = product16[2*j];
                        
                      if(addu_upoverflow[4*j+3])
                        result_data[j*32+1*16 +: 16] = 'hffff;
                      else
                        result_data[j*32+1*16 +: 16] = product16[2*j+1];
                    end
                    EEW32: begin
                      if(addu_upoverflow[4*j+3])
                        result_data[j*32 +: 32] = 'hffff_ffff;
                      else
                        result_data[j*32 +: 32] = product32[j];
                    end
                  endcase
                end

                VSADD: begin
                  case(vs2_eew)
                    EEW8: begin
                      if (add_upoverflow[4*j])
                        result_data[j*32 +: 8] = 'h7f;
                      else if (add_underoverflow[4*j])
                        result_data[j*32 +: 8] = 'h80;
                      else
                        result_data[j*32 +: 8] = product8[4*j];
                        
                      if (add_upoverflow[4*j+1])
                        result_data[j*32+1*8 +: 8] = 'h7f;
                      else if (add_underoverflow[4*j+1])
                        result_data[j*32+1*8 +: 8] = 'h80;
                      else
                        result_data[j*32+1*8 +: 8] = product8[4*j+1];
                      
                      if (add_upoverflow[4*j+2])
                        result_data[j*32+2*8 +: 8] = 'h7f;
                      else if (add_underoverflow[4*j+2])
                        result_data[j*32+2*8 +: 8] = 'h80;
                      else
                        result_data[j*32+2*8 +: 8] = product8[4*j+2];

                      if (add_upoverflow[4*j+3])
                        result_data[j*32+3*8 +: 8] = 'h7f;
                      else if (add_underoverflow[4*j+3])
                        result_data[j*32+3*8 +: 8] = 'h80;
                      else
                        result_data[j*32+3*8 +: 8] = product8[4*j+3];
                    end
                    EEW16: begin
                      if (add_upoverflow[4*j+1])
                        result_data[j*32 +: 16] = 'h7fff;
                      else if (add_underoverflow[4*j+1])
                        result_data[j*32 +: 16] = 'h8000;
                      else
                        result_data[j*32 +: 16] = product16[2*j];                   

                      if (add_upoverflow[4*j+3])
                        result_data[j*32+1*16 +: 16] = 'h7fff;
                      else if (add_underoverflow[4*j+3])
                        result_data[j*32+1*16 +: 16] = 'h8000;
                      else
                        result_data[j*32+1*16 +: 16] = product16[2*j+1];                   
                    end
                    EEW32: begin
                      if (add_upoverflow[4*j+3])
                        result_data[j*32 +: 32] = 'h7fff_ffff;
                      else if (add_underoverflow[4*j+3])
                        result_data[j*32 +: 32] = 'h8000_0000;
                      else
                        result_data[j*32 +: 32] = product32[j]; 
                    end
                  endcase
                end

                VSSUBU: begin
                  case(vs2_eew)
                    EEW8: begin
                      if(subu_underoverflow[4*j])
                        result_data[j*32 +: 8] = 'd0;
                      else
                        result_data[j*32 +: 8] = product8[4*j];
                        
                      if(subu_underoverflow[4*j+1])
                        result_data[j*32+1*8 +: 8] = 'd0;
                      else
                        result_data[j*32+1*8 +: 8] = product8[4*j+1];
                      
                      if(subu_underoverflow[4*j+2])
                        result_data[j*32+2*8 +: 8] = 'd0;
                      else
                        result_data[j*32+2*8 +: 8] = product8[4*j+2];

                      if(subu_underoverflow[4*j+3])
                        result_data[j*32+3*8 +: 8] = 'd0;
                      else
                        result_data[j*32+3*8 +: 8] = product8[4*j+3];
                    end
                    EEW16: begin
                      if(subu_underoverflow[4*j+1])
                        result_data[j*32 +: 16] = 'd0;
                      else
                        result_data[j*32 +: 16] = product16[2*j];
                        
                      if(subu_underoverflow[4*j+3])
                        result_data[j*32+1*16 +: 16] = 'd0;
                      else
                        result_data[j*32+1*16 +: 16] = product16[2*j+1];
                    end
                    EEW32: begin
                      if(subu_underoverflow[4*j+3])
                        result_data[j*32 +: 32] = 'd0;
                      else
                        result_data[j*32 +: 32] = product32[j];
                    end
                  endcase
                end

                VSSUB: begin
                  case(vs2_eew)
                    EEW8: begin
                      if (sub_upoverflow[4*j])
                        result_data[j*32 +: 8] = 'h7f;
                      else if (sub_underoverflow[4*j])
                        result_data[j*32 +: 8] = 'h80;
                      else
                        result_data[j*32 +: 8] = product8[4*j];
                        
                      if (sub_upoverflow[4*j+1])
                        result_data[j*32+1*8 +: 8] = 'h7f;
                      else if (sub_underoverflow[4*j+1])
                        result_data[j*32+1*8 +: 8] = 'h80;
                      else
                        result_data[j*32+1*8 +: 8] = product8[4*j+1];
                      
                      if (sub_upoverflow[4*j+2])
                        result_data[j*32+2*8 +: 8] = 'h7f;
                      else if (sub_underoverflow[4*j+2])
                        result_data[j*32+2*8 +: 8] = 'h80;
                      else
                        result_data[j*32+2*8 +: 8] = product8[4*j+2];

                      if (sub_upoverflow[4*j+3])
                        result_data[j*32+3*8 +: 8] = 'h7f;
                      else if (sub_underoverflow[4*j+3])
                        result_data[j*32+3*8 +: 8] = 'h80;
                      else
                        result_data[j*32+3*8 +: 8] = product8[4*j+3];
                    end
                    EEW16: begin
                      if (sub_upoverflow[4*j+1])
                        result_data[j*32 +: 16] = 'h7fff;
                      else if (sub_underoverflow[4*j+1])
                        result_data[j*32 +: 16] = 'h8000;
                      else
                        result_data[j*32 +: 16] = product16[2*j];                   

                      if (sub_upoverflow[4*j+3])
                        result_data[j*32+1*16 +: 16] = 'h7fff;
                      else if (sub_underoverflow[4*j+3])
                        result_data[j*32+1*16 +: 16] = 'h8000;
                      else
                        result_data[j*32+1*16 +: 16] = product16[2*j+1];                   
                    end
                    EEW32: begin
                      if (sub_upoverflow[4*j+3])
                        result_data[j*32 +: 32] = 'h7fff_ffff;
                      else if (sub_underoverflow[4*j+3])
                        result_data[j*32 +: 32] = 'h8000_0000;
                      else
                        result_data[j*32 +: 32] = product32[j]; 
                    end
                  endcase
                end

                VMINU: begin
                  case(vs2_eew)
                    EEW8: begin
                      result_minmax8[4*j+3] = cout8[4*j+3] ? src2_data[4*j+3] : src1_data[4*j+3];
                      result_minmax8[4*j+2] = cout8[4*j+2] ? src2_data[4*j+2] : src1_data[4*j+2];
                      result_minmax8[4*j+1] = cout8[4*j+1] ? src2_data[4*j+1] : src1_data[4*j+1];
                      result_minmax8[4*j  ] = cout8[4*j  ] ? src2_data[4*j  ] : src1_data[4*j  ];

                      result_data[j*32 +: 32] = {result_minmax8[4*j+3],
                                                                   result_minmax8[4*j+2],
                                                                   result_minmax8[4*j+1],
                                                                   result_minmax8[4*j]};
                    end
                    EEW16: begin
                      result_minmax16[2*j+1] = cout16[2*j+1] ? {src2_data[4*j+3],src2_data[4*j+2]} : {src1_data[4*j+3],src1_data[4*j+2]}; 
                      result_minmax16[2*j  ] = cout16[2*j  ] ? {src2_data[4*j+1],src2_data[4*j  ]} : {src1_data[4*j+1],src1_data[4*j  ]};

                      result_data[j*32 +: 32] = {result_minmax16[2*j+1],
                                                                   result_minmax16[2*j]};
                    end
                    EEW32: begin
                      result_minmax32[j] = cout32[j] ? {src2_data[4*j+3],src2_data[4*j+2],src2_data[4*j+1],src2_data[4*j]}: 
                                                       {src1_data[4*j+3],src1_data[4*j+2],src1_data[4*j+1],src1_data[4*j]}; 

                      result_data[j*32 +: 32] = result_minmax32[j];
                    end
                  endcase
                end

                VMIN: begin
                  case(vs2_eew)
                    EEW8: begin
                      case({src2_data[4*j][8-1],src1_data[4*j][8-1]})
                        2'b10  : result_minmax8[4*j] = src2_data[4*j];
                        2'b01  : result_minmax8[4*j] = src1_data[4*j];
                        default: result_minmax8[4*j] = product8[4*j][8-1] ? src2_data[4*j] : src1_data[4*j];
                      endcase

                      case({src2_data[4*j+1][8-1],src1_data[4*j+1][8-1]})
                        2'b10  : result_minmax8[4*j+1] = src2_data[4*j+1];
                        2'b01  : result_minmax8[4*j+1] = src1_data[4*j+1];
                        default: result_minmax8[4*j+1] = product8[4*j+1][8-1] ? src2_data[4*j+1] : src1_data[4*j+1];
                      endcase

                      case({src2_data[4*j+2][8-1],src1_data[4*j+2][8-1]})
                        2'b10  : result_minmax8[4*j+2] = src2_data[4*j+2];
                        2'b01  : result_minmax8[4*j+2] = src1_data[4*j+2];
                        default: result_minmax8[4*j+2] = product8[4*j+2][8-1] ? src2_data[4*j+2] : src1_data[4*j+2];
                      endcase

                      case({src2_data[4*j+3][8-1],src1_data[4*j+3][8-1]})
                        2'b10  : result_minmax8[4*j+3] = src2_data[4*j+3];
                        2'b01  : result_minmax8[4*j+3] = src1_data[4*j+3];
                        default: result_minmax8[4*j+3] = product8[4*j+3][8-1] ? src2_data[4*j+3] : src1_data[4*j+3];
                      endcase

                      result_data[j*32 +: 32] = {result_minmax8[4*j+3],
                                                                   result_minmax8[4*j+2],
                                                                   result_minmax8[4*j+1],
                                                                   result_minmax8[4*j]};
                    end
                    EEW16: begin
                      case({src2_data[4*j+1][8-1],src1_data[4*j+1][8-1]})
                        2'b10  : result_minmax16[2*j] = {src2_data[4*j+1],src2_data[4*j]};
                        2'b01  : result_minmax16[2*j] = {src1_data[4*j+1],src1_data[4*j]};
                        default: result_minmax16[2*j] = product16[2*j][16-1] ? {src2_data[4*j+1],src2_data[4*j]} : {src1_data[4*j+1],src1_data[4*j]};
                      endcase

                      case({src2_data[4*j+3][8-1],src1_data[4*j+3][8-1]})
                        2'b10  : result_minmax16[2*j+1] = {src2_data[4*j+3],src2_data[4*j+2]};
                        2'b01  : result_minmax16[2*j+1] = {src1_data[4*j+3],src1_data[4*j+2]};
                        default: result_minmax16[2*j+1] = product16[2*j+1][16-1] ? {src2_data[4*j+3],src2_data[4*j+2]} : {src1_data[4*j+3],src1_data[4*j+2]};
                      endcase

                      result_data[j*32 +: 32] = {result_minmax16[2*j+1],
                                                                   result_minmax16[2*j]};
                    end
                    EEW32: begin
                      case({src2_data[4*j+3][8-1],src1_data[4*j+3][8-1]})
                        2'b10  : result_minmax32[j] = {src2_data[4*j+3],src2_data[4*j+2],src2_data[4*j+1],src2_data[4*j]};
                        2'b01  : result_minmax32[j] = {src1_data[4*j+3],src1_data[4*j+2],src1_data[4*j+1],src1_data[4*j]};
                        default: result_minmax32[j] = product32[j][32-1] ? 
                                                        {src2_data[4*j+3],src2_data[4*j+2],src2_data[4*j+1],src2_data[4*j]}:
                                                        {src1_data[4*j+3],src1_data[4*j+2],src1_data[4*j+1],src1_data[4*j]}; 
                      endcase

                      result_data[j*32 +: 32] = result_minmax32[j];
                    end
                  endcase
                end

                VMAXU: begin
                  case(vs2_eew)
                    EEW8: begin
                      result_minmax8[4*j+3] = cout8[4*j+3] ? src1_data[4*j+3] : src2_data[4*j+3];
                      result_minmax8[4*j+2] = cout8[4*j+2] ? src1_data[4*j+2] : src2_data[4*j+2];
                      result_minmax8[4*j+1] = cout8[4*j+1] ? src1_data[4*j+1] : src2_data[4*j+1];
                      result_minmax8[4*j  ] = cout8[4*j  ] ? src1_data[4*j  ] : src2_data[4*j  ];

                      result_data[j*32 +: 32] = {result_minmax8[4*j+3],
                                                                   result_minmax8[4*j+2],
                                                                   result_minmax8[4*j+1],
                                                                   result_minmax8[4*j]};
                    end
                    EEW16: begin
                      result_minmax16[2*j+1] = cout16[2*j+1] ? {src1_data[4*j+3],src1_data[4*j+2]} : {src2_data[4*j+3],src2_data[4*j+2]}; 
                      result_minmax16[2*j  ] = cout16[2*j  ] ? {src1_data[4*j+1],src1_data[4*j  ]} : {src2_data[4*j+1],src2_data[4*j  ]};

                      result_data[j*32 +: 32] = {result_minmax16[2*j+1],
                                                                   result_minmax16[2*j]};
                    end
                    EEW32: begin
                      result_minmax32[j] = cout32[j] ? {src1_data[4*j+3],src1_data[4*j+2],src1_data[4*j+1],src1_data[4*j]}: 
                                                       {src2_data[4*j+3],src2_data[4*j+2],src2_data[4*j+1],src2_data[4*j]}; 

                      result_data[j*32 +: 32] = result_minmax32[j];
                    end
                  endcase
                end

                VMAX: begin
                  case(vs2_eew)
                    EEW8: begin
                      case({src2_data[4*j][8-1],src1_data[4*j][8-1]})
                        2'b01  : result_minmax8[4*j] = src2_data[4*j];
                        2'b10  : result_minmax8[4*j] = src1_data[4*j];
                        default: result_minmax8[4*j] = product8[4*j][8-1] ? src1_data[4*j] : src2_data[4*j];
                      endcase

                      case({src2_data[4*j+1][8-1],src1_data[4*j+1][8-1]})
                        2'b01  : result_minmax8[4*j+1] = src2_data[4*j+1];
                        2'b10  : result_minmax8[4*j+1] = src1_data[4*j+1];
                        default: result_minmax8[4*j+1] = product8[4*j+1][8-1] ? src1_data[4*j+1] : src2_data[4*j+1];
                      endcase

                      case({src2_data[4*j+2][8-1],src1_data[4*j+2][8-1]})
                        2'b01  : result_minmax8[4*j+2] = src2_data[4*j+2];
                        2'b10  : result_minmax8[4*j+2] = src1_data[4*j+2];
                        default: result_minmax8[4*j+2] = product8[4*j+2][8-1] ? src1_data[4*j+2] : src2_data[4*j+2];
                      endcase

                      case({src2_data[4*j+3][8-1],src1_data[4*j+3][8-1]})
                        2'b01  : result_minmax8[4*j+3] = src2_data[4*j+3];
                        2'b10  : result_minmax8[4*j+3] = src1_data[4*j+3];
                        default: result_minmax8[4*j+3] = product8[4*j+3][8-1] ? src1_data[4*j+3] : src2_data[4*j+3];
                      endcase

                      result_data[j*32 +: 32] = {result_minmax8[4*j+3],
                                                                   result_minmax8[4*j+2],
                                                                   result_minmax8[4*j+1],
                                                                   result_minmax8[4*j]};
                    end
                    EEW16: begin
                      case({src2_data[4*j+1][8-1],src1_data[4*j+1][8-1]})
                        2'b01  : result_minmax16[2*j] = {src2_data[4*j+1],src2_data[4*j]};
                        2'b10  : result_minmax16[2*j] = {src1_data[4*j+1],src1_data[4*j]};
                        default: result_minmax16[2*j] = product16[2*j][16-1] ? {src1_data[4*j+1],src1_data[4*j]} : {src2_data[4*j+1],src2_data[4*j]};
                      endcase

                      case({src2_data[4*j+3][8-1],src1_data[4*j+3][8-1]})
                        2'b01  : result_minmax16[2*j+1] = {src2_data[4*j+3],src2_data[4*j+2]};
                        2'b10  : result_minmax16[2*j+1] = {src1_data[4*j+3],src1_data[4*j+2]};
                        default: result_minmax16[2*j+1] = product16[2*j+1][16-1] ? {src1_data[4*j+3],src1_data[4*j+2]} : {src2_data[4*j+3],src2_data[4*j+2]};
                      endcase

                      result_data[j*32 +: 32] = {result_minmax16[2*j+1],
                                                                   result_minmax16[2*j]};
                    end
                    EEW32: begin
                      case({src2_data[4*j+3][8-1],src1_data[4*j+3][8-1]})
                        2'b01  : result_minmax32[j] = {src2_data[4*j+3],src2_data[4*j+2],src2_data[4*j+1],src2_data[4*j]};
                        2'b10  : result_minmax32[j] = {src1_data[4*j+3],src1_data[4*j+2],src1_data[4*j+1],src1_data[4*j]};
                        default: result_minmax32[j] = product32[j][32-1] ? 
                                                        {src1_data[4*j+3],src1_data[4*j+2],src1_data[4*j+1],src1_data[4*j]}:
                                                        {src2_data[4*j+3],src2_data[4*j+2],src2_data[4*j+1],src2_data[4*j]}; 
                      endcase

                      result_data[j*32 +: 32] = result_minmax32[j];
                    end
                  endcase
                end        
              endcase
            end
            
            OPMVV,
            OPMVX: begin
              case(uop_funct6.ari_funct6)
                VWADDU,
                VWSUBU,
                VWADD,
                VWSUB: begin
                  case(vs2_eew)
                    EEW8: begin
                      result_data[j*32 +: 32] = {product16[2*j+1], product16[2*j]};
                    end
                    EEW16: begin
                      result_data[j*32 +: 32] = product32[j];
                    end
                  endcase
                end

                VWADDU_W,
                VWSUBU_W,
                VWADD_W,
                VWSUB_W: begin
                  case(vs2_eew)
                    EEW16: begin
                      result_data[j*32 +: 32] = {product16[2*j+1], product16[2*j]};
                    end
                    EEW32: begin
                      result_data[j*32 +: 32] = product32[j];
                    end
                  endcase
                end

                VAADDU,
                VAADD,
                VASUBU,
                VASUB: begin
                  case(vs2_eew)
                    EEW8: begin
                      result_data[j*32 +: 32] = {round8[4*j+3], round8[4*j+2], round8[4*j+1], round8[4*j]};
                    end
                    EEW16: begin
                      result_data[j*32 +: 32] = {round16[2*j+1], round16[2*j]};
                    end
                    EEW32: begin
                      result_data[j*32 +: 32] = round32[j];
                    end
                  endcase
                end
              endcase
            end
          endcase
        end
      end
    end
  endgenerate


//
// submit result to ROB
//
  // get result_uop
  always_comb begin
    // initial the data
  


    result.rob_entry = alu_uop.rob_entry;
    result.w_valid   = alu_uop.is_addsub ? 'b1 : alu_uop.w_valid; 
    result.w_data    = alu_uop.is_addsub ? result_data : alu_uop.w_data; 
    result.vsaturate = alu_uop.is_addsub ? 'b0 : alu_uop.vsat_cout.vsaturate;
  



    case(uop_funct3) 
      OPIVV,
      OPIVX,
      OPIVI: begin
        case(uop_funct6.ari_funct6)
          VSADDU: begin
            result.vsaturate = addu_upoverflow;
          end
          VSADD: begin
            result.vsaturate = add_upoverflow|add_underoverflow;
          end
          VSSUBU: begin
            result.vsaturate = subu_underoverflow;
          end
          VSSUB: begin
            result.vsaturate = sub_upoverflow|sub_underoverflow;
          end
        endcase
      end
    endcase
  end

endmodule
