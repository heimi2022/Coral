genvar                                            i,j;

/////////////////////////////////
/////////////Main////////////////
/////////////////////////////////
generate
  for(j=0;j<4;j++) begin : gen_inter_logic
    assign w_addr[j]    = rob2rt_write_data[j].w_index;
