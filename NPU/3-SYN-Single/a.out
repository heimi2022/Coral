  fsm_state
  (
    .clk    (clk),
    .rst_n  (rst_n),
    .e      (next_state!=state),
    .d      (next_state),
    .q      (state)
  );
  
  // state transition
  always_comb begin
    next_state = state;

    case(state)
      DIV_IDLE: begin
        if(div_valid&(!trap_flush_rvv)) begin
          if ((count_en=='b1)&(count_d=='b1))
            next_state = DIV_PRINT;
          else
            next_state = DIV_WORKING;
        end
        else
          next_state = DIV_IDLE;
      end
      DIV_WORKING: begin
        if(div_valid&(!trap_flush_rvv)) begin
          if ((count_en=='b1)&(count_d=='b1))
            next_state = DIV_PRINT;
          else
            next_state = DIV_WORKING;
        end
        else
          next_state = DIV_IDLE;
      end
      DIV_PRINT: begin
        if (div_valid&(!result_ready)&(!trap_flush_rvv))
