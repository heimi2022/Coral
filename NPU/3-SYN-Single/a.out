module rvv_backend_decode_unit_de2
(
  lcmd_valid,
  lcmd,
  uop_index_remain,
  uop_valid,
  uop
);
//
// interface signals
//
  // CQ to Decoder unit signals
  input   logic                           lcmd_valid;
  input   LCMD_t                          lcmd;
  input   logic   [5-1:0]  uop_index_remain;
  
  // Decoder unit to Uops Queue signals
  output  logic       [6-1:0]   uop_valid;
  output  UOP_QUEUE_t [6-1:0]   uop;

//
// internal signals
//
  logic                                   valid_ari;
  logic                                   valid_lsu;
  // decoded arithmetic uops
  logic           [6-1:0]       uop_valid_ari;
  UOP_QUEUE_t     [6-1:0]       uop_ari;
  // decoded LSU uops
  logic           [6-1:0]       uop_valid_lsu;
  UOP_QUEUE_t     [6-1:0]       uop_lsu;

//
// decode
//
  // decode opcode
  assign valid_lsu  = lcmd_valid & ((lcmd.cmd.opcode==LOAD) | (lcmd.cmd.opcode==STORE));
  assign valid_ari  = lcmd_valid & (lcmd.cmd.opcode==RVV);
  
  // decode LSU instruction 
  rvv_backend_decode_unit_lsu_de2 u_lsu_decode_de2
