  input  [127:0] io_fabric_writeDataBits,
  input  [15:0]  io_fabric_writeDataStrb,
  output [8:0]   io_sram_address,
  output         io_sram_enable,
                 io_sram_isWrite,
  input  [7:0]   io_sram_readData_0,
                 io_sram_readData_1,
                 io_sram_readData_2,
                 io_sram_readData_3,
                 io_sram_readData_4,
                 io_sram_readData_5,
