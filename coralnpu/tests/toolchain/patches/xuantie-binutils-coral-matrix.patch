diff --git a/opcodes/riscv-dis-xt.inc b/opcodes/riscv-dis-xt.inc
index b130643307d..63c478d2650 100644
--- a/opcodes/riscv-dis-xt.inc
+++ b/opcodes/riscv-dis-xt.inc
@@ -71,6 +71,35 @@ riscv_xuantie_print_args (const char **oparg, insn_t l, bfd_vma pc ATTRIBUTE_UNU
 
   switch (*arg)
     {
+    case 'C': /* CoralNPU matrix register fields.  */
+      if (*++arg != 'M')
+	{
+	  ret = false;
+	  break;
+	}
+      switch (*++arg)
+	{
+	case 'd':
+	  print (info->stream, dis_style_register, "%s",
+		 riscv_xuantie_mr_names_numeric[EXTRACT_BITS
+		   (l, OP_MASK_CORAL_MD, OP_SH_CORAL_MD)]);
+	  break;
+	case 's':
+	  print (info->stream, dis_style_register, "%s",
+		 riscv_xuantie_mr_names_numeric[EXTRACT_BITS
+		   (l, OP_MASK_CORAL_MS1, OP_SH_CORAL_MS1)]);
+	  break;
+	case 't':
+	  print (info->stream, dis_style_register, "%s",
+		 riscv_xuantie_mr_names_numeric[EXTRACT_BITS
+		   (l, OP_MASK_CORAL_MS2, OP_SH_CORAL_MS2)]);
+	  break;
+	default:
+	  ret = false;
+	  break;
+	}
+      break;
+
     case 'M': /* Matrix.  */
       switch (*++arg)
 	{
