From ec857d9cd0909c5b3cba58e0d5ac861669fe7eeb Mon Sep 17 00:00:00 2001
From: jj <220256672@seu.edu.cn>
Date: Sun, 4 Oct 2026 20:28:12 +0800
Subject: [PATCH] riscv: add Coral Matrix assembler and disassembler

---
 bfd/elfxx-riscv-xt.h            |   1 +
 gas/config/tc-riscv-xt.inc      |  48 ++++++++++
 include/opcode/riscv-opc-xt.def | 154 ++++++++++++++++++++++++++++++++
 include/opcode/riscv-xt.h       |   1 +
 opcodes/riscv-dis-xt.inc        |  29 ++++++
 opcodes/riscv-opc-xt.def        |  74 ++++++++++++++-
 opcodes/riscv-opc.c             |   8 ++
 7 files changed, 313 insertions(+), 2 deletions(-)

diff --git a/bfd/elfxx-riscv-xt.h b/bfd/elfxx-riscv-xt.h
index 8bb119bb530..be4259e8f74 100644
--- a/bfd/elfxx-riscv-xt.h
+++ b/bfd/elfxx-riscv-xt.h
@@ -60,6 +60,7 @@ xuantie_check_implicit_matrix0p3 (const char *implicit ATTRIBUTE_UNUSED,
   M ("xtheadvfofp6min", INSN_CLASS_XTHEADVFOFP6MIN, 0, 2, 0)                  \
   M ("xtheadvsfb", INSN_CLASS_XTHEADVSFB, 0, 2, 0)                            \
   M ("xtheadcrc", INSN_CLASS_XTHEADCRC, 0, 1, 0)                              \
+  M ("xcoralmatrix", INSN_CLASS_XCORALMATRIX, 1, 0, 0)                         \
   M ("xxtcsrcacherpl", INSN_CLASS_XXTCSRCACHERPL, 1, 0, 0)
 
 #define XUANTIE_M_riscv_supported_vendor_x_ext(xstring, class, r, p, s) \
diff --git a/gas/config/tc-riscv-xt.inc b/gas/config/tc-riscv-xt.inc
index bd4c2b6460f..059a847cebd 100644
--- a/gas/config/tc-riscv-xt.inc
+++ b/gas/config/tc-riscv-xt.inc
@@ -83,6 +83,24 @@ riscv_xuantie_use_bits (const char **poparg, insn_t *used_bits)
 	  break;
 	default:
 	  break;
+	  }
+      break;
+    case 'C': /* CoralNPU matrix register fields.  */
+      if (*++oparg != 'M')
+	return false;
+      switch (*++oparg)
+	{
+	case 'd': /* Coral md.  */
+	  USE_BITS (OP_MASK_CORAL_MD, OP_SH_CORAL_MD);
+	  break;
+	case 's': /* Coral ms1.  */
+	  USE_BITS (OP_MASK_CORAL_MS1, OP_SH_CORAL_MS1);
+	  break;
+	case 't': /* Coral ms2.  */
+	  USE_BITS (OP_MASK_CORAL_MS2, OP_SH_CORAL_MS2);
+	  break;
+	default:
+	  return false;
 	}
       break;
     case 'P':
@@ -179,6 +197,36 @@ riscv_xuantie_parsing_args (const char **poparg, char **pasarg,
 	  goto err_out;
 	}
       break;
+    case 'C': /* CoralNPU matrix register fields.  */
+      if (*++oparg != 'M')
+	goto err_out;
+      switch (*++oparg)
+	{
+	case 'd': /* Coral md.  */
+	  if (reg_lookup (&asarg, RCLASS_MR, &regno))
+	    {
+	      INSERT_OPERAND (CORAL_MD, *ip, regno);
+	      break;
+	    }
+	  goto err_out;
+	case 's': /* Coral ms1.  */
+	  if (reg_lookup (&asarg, RCLASS_MR, &regno))
+	    {
+	      INSERT_OPERAND (CORAL_MS1, *ip, regno);
+	      break;
+	    }
+	  goto err_out;
+	case 't': /* Coral ms2.  */
+	  if (reg_lookup (&asarg, RCLASS_MR, &regno))
+	    {
+	      INSERT_OPERAND (CORAL_MS2, *ip, regno);
+	      break;
+	    }
+	  goto err_out;
+	default:
+	  goto err_out;
+	}
+      break;
 
     case 'P':
       switch (*++oparg)
diff --git a/include/opcode/riscv-opc-xt.def b/include/opcode/riscv-opc-xt.def
