 /* Xuantie Matrix 0.3.  */
 #define MATCH_TH_FMMACC_H 0x1000042b
 #define MASK_TH_FMMACC_H 0xff007fff
@@ -2444,6 +2591,13 @@ DECLARE_CSR_ALIAS(mintstatus, CSR_MINTSTATUS_OLD, CSR_CLASS_XTHEAD, PRIV_SPEC_CL
 #define OP_SH_MS3               7
 #define OP_MASK_MATRIX_NF       0x7
 #define OP_SH_MATRIX_NF         20
+/* CoralNPU matrix fields.  */
