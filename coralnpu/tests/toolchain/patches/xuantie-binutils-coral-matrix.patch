+#define MASK_CORAL_MSBE8 0xfe007c7f
+#define MATCH_CORAL_MSBE16 0x1600042b
+#define MASK_CORAL_MSBE16 0xfe007c7f
+#define MATCH_CORAL_MSBE32 0x1600082b
+#define MASK_CORAL_MSBE32 0xfe007c7f
+#define MATCH_CORAL_MSBE64 0x16000c2b
+#define MASK_CORAL_MSBE64 0xfe007c7f
+#define MATCH_CORAL_MLCE8 0x2400002b
+#define MASK_CORAL_MLCE8 0xfe007c7f
+#define MATCH_CORAL_MLCE16 0x2400042b
+#define MASK_CORAL_MLCE16 0xfe007c7f
